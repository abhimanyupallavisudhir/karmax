{
  "name": "karmax",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An agent-orchestration platform centered on a todo list, on a durable-execution substrate (Temporal).",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "karmax": "bin/karmax.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "worker": "tsx src/temporal/run-worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "reset": "tsx src/scripts/reset.ts",
    "backup": "tsx src/scripts/backup.ts",
    "restore": "tsx src/scripts/restore.ts"
  },
  "dependencies": {
    "@1password/sdk": "^0.4.1",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@daytona/sdk": "^0.196.0",
    "@e2b/desktop": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "0.144.5",
    "@temporalio/activity": "^1.20.2",
    "@temporalio/client": "^1.20.2",
    "@temporalio/common": "^1.20.2",
    "@temporalio/worker": "^1.20.2",
    "@temporalio/workflow": "^1.20.2",
    "better-auth": "^1.6.23",
    "e2b": "^2.33.0",
    "imapflow": "^1.5.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
