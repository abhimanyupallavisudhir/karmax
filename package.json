{
  "name": "karmax",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "An agent-orchestration platform centered on a todo list, on a durable-execution substrate (Temporal).",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "tavya": "bin/tavya.js",
    "karmax": "bin/tavya.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "postinstall": "node scripts/fetch-restic.mjs",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "preview:landing": "node scripts/preview-landing.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:durations": "tsx scripts/test-durations.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:lowmem": "node scripts/typecheck-lowmem.mjs",
    "lint": "tsx scripts/lint.ts",
    "reset": "tsx src/scripts/reset.ts",
    "backup": "tsx src/scripts/backup.ts",
    "restore": "tsx src/scripts/restore.ts",
    "vault-preflight": "tsx src/scripts/vault-preflight.ts",
    "audit-check": "tsx scripts/audit.ts",
    "vault-key": "tsx src/scripts/vault-key.ts",
    "migrate-objects": "tsx src/scripts/object-store-migrate.ts",
    "object-store-check": "tsx src/scripts/object-store-check.ts",
    "replay-check": "tsx src/scripts/replay-check.ts",
    "benchmark:latency": "tsx benchmarks/latency.ts",
    "timing:report": "tsx src/scripts/timing-report.ts",
    "deploy-repository-edge": "tsx src/scripts/deploy-repository-edge.ts"
  },
  "dependencies": {
    "@1password/sdk": "^0.5.0",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@composio/client": "0.1.0-alpha.76",
    "@daytona/sdk": "^0.218.0",
    "@e2b/desktop": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex": "0.156.1",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "better-auth": "^1.7.6",
    "e2b": "^2.51.0",
    "esbuild": "0.28.1",
    "imapflow": "^1.5.0",
    "kysely": "0.28.17",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.16.3",
    "tldts": "^7.4.15",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@temporalio/proto": "^1.24.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
