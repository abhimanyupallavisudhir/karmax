# dependencies (no trailing slash: a worktree's node_modules symlink is ignored too)
node_modules

# build output
dist/
*.tsbuildinfo

# karmax runtime data (workflow repos, worlds, config homes, vault, temporal db, state)
.karmax/
.karmax-data/
# Unanchored on purpose. deploy/karmax derives its own directory from $0, so
# invoking it any way other than `./deploy/karmax` — sourcing it, for instance —
# writes the generated secrets relative to the caller instead. That put a real
# auth_secret and vault_key at the repo root once, one `git add -A` away from
# being committed. Matching at any depth costs nothing.
.turnkey.env
.turnkey.env.migration.*
.secrets/
deploy/backups/
deploy/.updates/
design/*.png
design/**/*.png

# logs / coverage / caches
*.log
coverage/
.vitest/
.cache/
__pycache__/
*.py[cod]

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp
