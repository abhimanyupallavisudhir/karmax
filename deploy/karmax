#!/bin/sh
# Turnkey Karmax control-plane operator. Requires only Docker with Compose.
set -eu

# The detached update runner executes a copy of this file from
# deploy/.updates/<key>/ and names the instance it belongs to.
DEPLOY_DIR=${KARMAX_DEPLOY_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
ROOT_DIR=$(dirname "$DEPLOY_DIR")
ENV_FILE="$DEPLOY_DIR/.turnkey.env"
SECRETS_DIR="$DEPLOY_DIR/.secrets"
COMPOSE_FILE="$DEPLOY_DIR/compose.turnkey.yml"

die() { echo "karmax: $*" >&2; exit 1; }
note() { echo "• $*"; }
# Compose recreates a container when its configuration changes, not when a file
# it mounts does, and Caddy's admin API is off, so it cannot reload. Worse, the
# Caddyfile is a single-file bind mount: git checkout replaces the file by
# rename, so a running container keeps the old inode and never even sees the
# new content (tavya.io served its 2026-10-02 Caddyfile until task #529). The
# Caddyfile's digest is therefore a label on Caddy: every `up` recreates it,
# binding the new file, whenever the Caddyfile changed.
dc() {
  KARMAX_CADDYFILE_SHA256=$(sha256sum "$DEPLOY_DIR/Caddyfile" 2>/dev/null | cut -d' ' -f1) \
    docker compose --project-directory "$DEPLOY_DIR" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

# The checksums cover the dumps and secrets outside the signed control-plane
# manifest, and the manifest itself, so the two signatures vouch for one backup.
backup_checksums() (
  destination=$1
  (cd "$destination" && sha256sum *.dump deployment-secrets/* control-plane/manifest.json > SHA256SUMS)
)

# The checksums are signed by the same installation key (DB-10). $1 is the
# app invocation: `exec -T app` for the live app, `run --rm --no-deps -T app`
# for a validated candidate.
sign_checksums() (
  destination=$1; shift
  dc "$@" npm run --silent backup -- --sign-checksums < "$destination/SHA256SUMS" > "$destination/SHA256SUMS.sig"
)

# Every deployment secret except the vault key (SS-2): the vault's data keys
# are wrapped under it, so a backup that carried it would decrypt every secret
# it holds. Keep deploy/.secrets/vault_key off-host instead; restore needs it.
copy_deployment_secrets() (
  destination=$1
  mkdir "$destination" && chmod 700 "$destination" || exit 1
  for secret in "$SECRETS_DIR"/*; do
    case "$(basename "$secret")" in vault_key|vault_key.*) continue ;; esac
    [ -f "$secret" ] || continue
    cp -p "$secret" "$destination/" || exit 1
  done
)

compact_backups() {
  # Optional space optimization must never invalidate a verified backup or
  # prevent an emergency deployment on a host without util-linux hardlink.
  sh "$DEPLOY_DIR/compact-backups.sh" "$DEPLOY_DIR/backups" || note 'Backup compaction failed; snapshots are retained.'
}

# Automatic snapshots are restore points for undoing a recent deploy, not an
# archive: each carries fresh database dumps (tavya.io held 84 of them, 144 GB of
# 193 GB before compaction), and they share the disk they protect. A daily
# off-host copy is the hosting provider's job (tavya.io: one.com's daily image).
# Earlier updaters named their snapshots by bare UTC stamp and aged them out
# after two weeks; they keep that rule. Any other name (manual-*, incident-*, a
# chosen path) is an operator's backup and is never pruned.
PREDEPLOY_KEEP=10
prune_backups() {
  backups="$DEPLOY_DIR/backups"
  [ -d "$backups" ] || return 0
  # Fixed-width UTC stamps: name order is age order.
  for name in $(ls -1 "$backups" | grep -E '^predeploy-[0-9]{8}T[0-9]{6}Z$' | sort -r | tail -n "+$((PREDEPLOY_KEEP + 1))"); do
    rm -rf "${backups:?}/$name"
  done
  for name in $(ls -1 "$backups" | grep -E '^[0-9]{8}T[0-9]{6}Z$'); do
    if [ -n "$(find "$backups/$name" -prune -type d -mtime +14)" ]; then rm -rf "${backups:?}/$name"; fi
  done
}

# Housekeeping once the new revision serves; none of it may fail an update.
reclaim_space() {
  prune_backups || note 'Could not prune old snapshots; they are retained.'
  compact_backups
  prune_build_cache
}

# Each build leaves superseded layers behind, and the replaced image dangles;
# unbounded, build cache alone reached 15.6 GB on tavya.io. A rollback rebuilds
# the previous revision from source, so neither is needed once the update is up.
prune_build_cache() {
  docker image prune -f >/dev/null || true
  docker builder prune -f --max-used-space 8gb >/dev/null 2>&1 \
    || docker builder prune -f --keep-storage 8gb >/dev/null 2>&1 \
    || docker builder prune -f --filter until=72h >/dev/null || true
}

need_docker() {
  command -v docker >/dev/null 2>&1 || die 'Docker is required: https://docs.docker.com/engine/install/'
  docker compose version >/dev/null 2>&1 || die 'Docker Compose v2 is required (the `docker compose` command)'
  docker info >/dev/null 2>&1 || die 'Docker is not running, or this user cannot access it'
}

valid_domain() {
  case "$1" in
    ''|*://*|*/*|*:*|.*|*..*|*.) return 1 ;;
    *[!A-Za-z0-9.-]*) return 1 ;;
  esac
  printf '%s\n' "$1" | awk -F. '
    length($0) > 253 || NF < 2 { exit 1 }
    { for (i=1; i<=NF; i++) if (length($i) > 63 || $i !~ /^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$/ && $i !~ /^[A-Za-z0-9]$/) exit 1 }
  '
}

env_value() {
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

random_hex() { od -An -N"${1:-48}" -tx1 /dev/urandom | tr -d ' \n'; }

# Compose bind-mounts these files into the app container with their host
# ownership intact, and that container runs as its own unprivileged uid (see
# deploy/Dockerfile) which matches no host user — so a 0600 secret is
# unreadable exactly where it is needed. $SECRETS_DIR stays 0700, which is what
# actually keeps other users on the host out: they cannot traverse into it.
secret_mode() { set_mode 644 "$@"; }

# chmod fails for anyone but a file's owner even when it would change nothing,
# and a secret `sudo ./deploy/karmax up` created belongs to root; so only a
# mode that differs is changed.
set_mode() {
  wanted_mode=$1; shift
  for mode_target in "$@"; do
    [ -n "$(find "$mode_target" -prune -perm "$wanted_mode" 2>/dev/null)" ] \
      || chmod "$wanted_mode" "$mode_target" || return 1
  done
}

write_secret() {
  file="$SECRETS_DIR/$1"
  { [ -s "$file" ] || random_hex 48 > "$file"; } && secret_mode "$file"
}

# Every secret compose.turnkey.yml mounts; existing ones are kept. Updates and
# restores call this too, so a release that mounts a new secret can start.
# A subshell, so the umask cannot reach files a later checkout writes. Every
# step checks its status because callers test it with `if`, where `set -e`
# does not apply.
ensure_secrets() (
  umask 077
  mkdir -p "$SECRETS_DIR" && set_mode 700 "$SECRETS_DIR" || exit 1
  for secret in auth_secret vault_key world_ref_key; do
    write_secret "$secret" || exit 1
  done
  # The S3 object store's keys are the operator's to write (see
  # KARMAX_OBJECT_STORE in .turnkey.env); empty means not configured.
  # So are the off-host PostgreSQL backups' (configure-backups writes them),
  # and the previews' DNS token (KARMAX_PREVIEW_TLS=cloudflare).
  for secret in s3_access_key_id s3_secret_access_key \
      pg_backup_access_key_id pg_backup_secret_access_key pg_backup_public_key \
      cloudflare_dns_api_token; do
    { [ -e "$SECRETS_DIR/$secret" ] || (umask 022 && : > "$SECRETS_DIR/$secret"); } \
      && secret_mode "$SECRETS_DIR/$secret" || exit 1
  done
)

# The images this checkout builds for an update: the app, PostgreSQL with
# WAL-G (since the off-host backups) and Caddy with its modules (Compose builds
# an image only when it is missing, so a changed Caddy.Dockerfile would never
# reach a running edge otherwise). A rollback to a release whose postgresql
# service is a stock image builds nothing for it. PostgreSQL's and Caddy's bases
# are pinned and not re-pulled, so an unchanged image is never recreated.
build_images() {
  if [ "${1:-}" = --pull ]; then dc build --pull app && dc build postgresql caddy
  else dc build app postgresql caddy
  fi
}

configure() {
  requested_domain=${1:-}
  existing_domain=$(env_value KARMAX_DOMAIN)
  domain=${requested_domain:-$existing_domain}
  [ -n "$domain" ] || die 'usage: ./deploy/karmax up karmax.example.com [preview.example.com]'
  domain=$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]')
  valid_domain "$domain" || die "invalid domain: $domain"
  if [ -n "${2:-}" ]; then preview=$2
  elif [ -n "$requested_domain" ] && [ "$domain" != "$existing_domain" ]; then preview="preview.$domain"
  else preview=$(env_value KARMAX_PREVIEW_DOMAIN)
  fi
  [ -n "$preview" ] || preview="preview.$domain"
  preview=$(printf '%s' "$preview" | tr '[:upper:]' '[:lower:]')
  valid_domain "$preview" || die "invalid preview domain: $preview"
  [ "$domain" != "$preview" ] || die 'the preview domain must be different from the application domain'

  # Moving previews to another domain keeps the previous one serving the leases
  # already issued under it, until they expire (the app and Caddyfile read it).
  existing_preview=$(env_value KARMAX_PREVIEW_DOMAIN)
  legacy_preview=$(env_value KARMAX_LEGACY_PREVIEW_DOMAIN)
  if [ -n "$existing_preview" ] && [ "$existing_preview" != "$preview" ]; then legacy_preview=$existing_preview; fi
  [ "$legacy_preview" != "$preview" ] || legacy_preview=''

  legacy=$(env_value KARMAX_LEGACY_DOMAIN)
  if [ -z "$legacy" ] && [ -n "$existing_domain" ] && [ "$domain" != "$existing_domain" ]; then
    legacy=$existing_domain
  fi
  if [ -n "$legacy" ]; then
    legacy=$(printf '%s' "$legacy" | tr '[:upper:]' '[:lower:]')
    valid_domain "$legacy" || die "invalid legacy domain: $legacy"
    [ "$legacy" != "$domain" ] || legacy=''
  fi

  old_password=$(env_value POSTGRES_PASSWORD)
  password=${old_password:-$(random_hex 32)}
  old_provider=$(env_value KARMAX_CLOUD_WORLD_PROVIDER)
  provider=${old_provider:-e2b}
  old_temporal=$(env_value TEMPORAL_VERSION)
  temporal=${old_temporal:-1.31.0}
  old_postgres=$(env_value POSTGRES_VERSION)
  postgres=${old_postgres:-16}

  # This file is rewritten wholesale below, so anything the managed keys
  # above do not carry over is deleted. Operators legitimately add their own
  # settings here (a social OAuth client, a mailer), and losing one at the next
  # `up` is invisible: no error, the feature just quietly stops existing. So
  # capture every other assignment now, before the truncation, and re-emit it.
  carried=''
  if [ -f "$ENV_FILE" ]; then
    carried=$(awk '
      BEGIN { split("KARMAX_DOMAIN KARMAX_PREVIEW_DOMAIN KARMAX_LEGACY_DOMAIN KARMAX_LEGACY_WWW_DOMAIN KARMAX_LEGACY_PREVIEW_DOMAIN KARMAX_PENDING_DOMAIN KARMAX_PENDING_PREVIEW_DOMAIN KARMAX_CLOUD_WORLD_PROVIDER \
        POSTGRES_PASSWORD TEMPORAL_VERSION POSTGRES_VERSION", m, " ")
        for (i in m) managed[m[i]] = 1 }
      /^[A-Za-z_][A-Za-z0-9_]*=/ {
        if (!((key = substr($0, 1, index($0, "=") - 1)) in managed)) print
      }' "$ENV_FILE")
  fi

  ensure_secrets
  # Only the file itself is private: a bare umask here would outlive this
  # function, and an update that stages a domain move checks out the release
  # next, which the app (another uid) must be able to read.
  ( umask 077
  {
    printf 'KARMAX_DOMAIN=%s\n' "$domain"
    printf 'KARMAX_PREVIEW_DOMAIN=%s\n' "$preview"
    [ -z "$legacy_preview" ] || printf 'KARMAX_LEGACY_PREVIEW_DOMAIN=%s\n' "$legacy_preview"
    if [ -n "$legacy" ]; then
      printf 'KARMAX_LEGACY_DOMAIN=%s\n' "$legacy"
      printf 'KARMAX_LEGACY_WWW_DOMAIN=www.%s\n' "$legacy"
    fi
    printf 'KARMAX_CLOUD_WORLD_PROVIDER=%s\n' "$provider"
    printf 'POSTGRES_PASSWORD=%s\n' "$password"
    printf 'TEMPORAL_VERSION=%s\n' "$temporal"
    printf 'POSTGRES_VERSION=%s\n' "$postgres"
    [ -z "$carried" ] || printf '%s\n' "$carried"
  } > "$ENV_FILE" )
  chmod 600 "$ENV_FILE"
}

# KARMAX_PREVIEW_TLS=cloudflare serves previews under one wildcard certificate,
# which Caddy proves by writing a DNS record with this token. Without it Caddy
# would start and fail every preview handshake, so refuse here instead.
preview_tls_ready() {
  case "$(env_value KARMAX_PREVIEW_TLS)" in
    ''|on-demand) return 0 ;;
    cloudflare)
      [ -s "$SECRETS_DIR/cloudflare_dns_api_token" ] && return 0
      echo "karmax: KARMAX_PREVIEW_TLS=cloudflare needs a Cloudflare API token with Zone DNS Edit and Zone Read on $(env_value KARMAX_PREVIEW_DOMAIN) only, in deploy/.secrets/cloudflare_dns_api_token" >&2
      return 1 ;;
    *) echo "karmax: KARMAX_PREVIEW_TLS must be on-demand or cloudflare, not $(env_value KARMAX_PREVIEW_TLS)" >&2
      return 1 ;;
  esac
}

wait_ready() {
  note 'Waiting for the Karmax control plane to become ready…'
  attempt=0
  until dc exec -T app node -e "fetch('http://127.0.0.1:4505/api/health/ready',{signal:AbortSignal.timeout(5000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 90 ]; then
      dc ps
      dc logs --tail=100 app temporal >&2 || true
      echo 'karmax: Karmax did not become ready; the diagnostic logs are above' >&2
      return 1
    fi
    sleep 2
  done
}

# Caddy is the only way in, so "ready" means a request crosses it: the host's
# own HTTPS to this domain, answered by the app's readiness route. -k because
# the question is whether the edge reaches the app, not whether the certificate
# is publicly trusted; --resolve keeps DNS out of it.
edge_answers() {
  domain=$(env_value KARMAX_DOMAIN)
  [ -n "$domain" ] && command -v curl >/dev/null 2>&1 || return 1
  code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 5 --resolve "$domain:443:127.0.0.1" \
    "https://$domain/api/health/ready" 2>/dev/null) || code=000
  [ "$code" = 200 ]
}

# Compose starts Caddy only once the app is healthy, so the app can be ready
# while Caddy is still loading. Plain HTTP needs neither DNS nor a certificate:
# Caddy redirects it to HTTPS as soon as it serves this domain.
edge_serves() {
  domain=$(env_value KARMAX_DOMAIN)
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 --resolve "$domain:80:127.0.0.1" \
    "http://$domain/" 2>/dev/null) || code=000
  [ "$code" = 308 ]
}

# poll_edge PROBE FAILURE: wait up to a minute for PROBE, else show Caddy.
poll_edge() {
  attempt=0
  until "$1"; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
      dc ps caddy || true
      dc logs --tail=50 caddy >&2 || true
      echo "karmax: $2; its logs are above" >&2
      return 1
    fi
    sleep 2
  done
}

wait_edge() {
  note 'Waiting for the public edge (Caddy) to reach the control plane…'
  poll_edge edge_answers "https://$(env_value KARMAX_DOMAIN) no longer answers through Caddy"
}

wait_edge_serving() {
  command -v curl >/dev/null 2>&1 || { note 'curl is not installed, so Caddy is not checked.'; return 0; }
  note 'Waiting for the public edge (Caddy) to start…'
  poll_edge edge_serves "Caddy is not serving $(env_value KARMAX_DOMAIN)"
}

print_finish() {
  domain=$(env_value KARMAX_DOMAIN)
  preview=$(env_value KARMAX_PREVIEW_DOMAIN)
  cat <<EOF

Karmax is ready: https://$domain

DNS must point at this VPS:
  A/AAAA  $domain
  A/AAAA  *.$preview

Caddy obtains and renews HTTPS certificates automatically. Open Karmax, create
the first administrator, then connect GitHub and E2B or Daytona in Organization
settings. No provider secrets or GitHub keys belong in this file.
EOF
}

cmd_up() {
  need_docker
  configure "${1:-}" "${2:-}"
  preview_tls_ready || die 'previews are not configured; nothing was started'
  dc config --quiet
  note 'Building and starting PostgreSQL, Temporal, Karmax, and Caddy…'
  dc up -d --build --remove-orphans
  wait_ready || die 'Karmax failed its readiness check'
  wait_edge_serving || die 'Caddy failed to start'
  print_finish
}

# A KARMAX_DATABASE_URL left in the app's karmax.env wins over the role's URL,
# so ask PostgreSQL what the app actually connected as. The app names its
# sessions, so an operator's psql or a backup's pg_dump does not count. Never
# fails: it only reports.
report_app_role() {
  sessions=$(dc exec -T postgresql psql -U temporal -d postgres -Atc "SELECT DISTINCT a.usename, r.rolsuper
    FROM pg_stat_activity a JOIN pg_roles r ON r.rolname = a.usename
    WHERE a.datname = 'karmax' AND a.application_name = 'karmax'" < /dev/null) || {
    echo 'karmax: warning: could not ask PostgreSQL which role the app connects as' >&2
    return 0
  }
  [ -n "$sessions" ] || { note 'The app has no connection to the karmax database right now.'; return 0; }
  printf '%s\n' "$sessions" | while IFS='|' read -r role superuser; do
    [ -n "$role" ] || continue
    if [ "$superuser" = t ]; then
      echo "karmax: warning: the app connects to PostgreSQL as the superuser $role. Remove KARMAX_DATABASE_URL from /var/lib/karmax/karmax.env and restart the app." >&2
    else
      note "The app connects to PostgreSQL as $role, not a superuser."
    fi
  done
}

# Each running container's memory use against its cap (KARMAX_*_MEM_LIMIT in
# .turnkey.env), what the caps leave the host, and PostgreSQL's sizing to its
# own cap (deploy/README.md, "Memory caps"). Never fails: it only reports.
report_memory() {
  containers=$(dc ps -q < /dev/null) || containers=''
  [ -n "$containers" ] || { note 'No container is running, so there are no memory caps to report.'; return 0; }
  note 'Memory in use / cap:'
  # shellcheck disable=SC2086 # one argument per container
  docker stats --no-stream --format '    {{.Name}}  {{.MemUsage}}' $containers < /dev/null || true
  # shellcheck disable=SC2086
  caps_mb=$(docker inspect --format '{{.HostConfig.Memory}}' $containers < /dev/null 2>/dev/null \
    | awk '$1 == 0 { uncapped = 1 } { sum += $1 } END { if (!uncapped && NR) printf "%d", sum / 1048576 }') || caps_mb=''
  host_mb=$(awk '/^MemTotal:/ { printf "%d", $2 / 1024 }' /proc/meminfo 2>/dev/null) || host_mb=''
  if [ -n "$caps_mb" ] && [ -n "$host_mb" ]; then
    if [ "$caps_mb" -gt "$host_mb" ]; then
      echo "karmax: warning: the running containers' memory caps add up to $caps_mb MiB, more than the host's $host_mb MiB; lower a KARMAX_*_MEM_LIMIT in .turnkey.env" >&2
    else
      note "The caps add up to $caps_mb of the host's $host_mb MiB, leaving $((host_mb - caps_mb)) MiB for the host itself."
    fi
  fi
  settings=$(dc exec -T postgresql psql -U temporal -d postgres -Atc "SELECT 'shared_buffers ' || current_setting('shared_buffers')
    || ', effective_cache_size ' || current_setting('effective_cache_size') || ', work_mem ' || current_setting('work_mem')
    || ', maintenance_work_mem ' || current_setting('maintenance_work_mem') || '; '
    || (SELECT count(*) FROM pg_stat_activity WHERE backend_type = 'client backend') || ' of '
    || current_setting('max_connections') || ' connections in use'" < /dev/null) \
    && note "PostgreSQL: $settings" \
    || echo 'karmax: warning: could not read PostgreSQL memory settings' >&2
}

cmd_doctor() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured; run `./deploy/karmax up your-domain`'
  dc config --quiet
  note 'Compose configuration is valid.'
  for secret in auth_secret vault_key world_ref_key; do
    [ -s "$SECRETS_DIR/$secret" ] || die "missing secret: $secret"
  done
  note 'Durable secrets are present.'
  preview_tls_ready || die 'previews cannot get certificates'
  if [ -e "$SECRETS_DIR/vault_key.next" ] || [ -e "$SECRETS_DIR/vault_key.previous" ]; then
    echo 'karmax: warning: a vault key rotation is unfinished; run ./deploy/karmax rotate-vault-key to finish it' >&2
  fi
  dc ps
  report_memory
  report_app_role
  # Names the store; an S3 one must accept a write, read-back and delete.
  objects_ok=1
  dc exec -T app npm run --silent object-store-check < /dev/null || objects_ok=''
  # Off-host PostgreSQL backups: no WAL waiting longer than 10 minutes, and a
  # base backup within the interval (deploy/postgres/pg-backup.sh status).
  backups_ok=1
  if [ -n "$(env_value KARMAX_PG_BACKUP_PREFIX)" ]; then
    dc exec -T pg-backup karmax-pg-backup status < /dev/null || backups_ok=''
  else
    note 'Off-host PostgreSQL backups are off: a lost host loses everything since its last disk image (./deploy/karmax configure-backups).'
  fi
  domain=$(env_value KARMAX_DOMAIN)
  if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 10 "https://$domain/api/health/ready" >/dev/null 2>&1; then
    note "Public HTTPS health check passed for $domain."
  else
    note "Public HTTPS is not reachable yet. Check DNS for $domain and ports 80/443."
  fi
  [ -n "$objects_ok" ] || die 'object store check failed; see its output above'
  [ -n "$backups_ok" ] || die 'off-host PostgreSQL backups are not current; see above and ./deploy/karmax logs pg-backup'
}

# Turn on continuous off-host PostgreSQL backups (WAL-G, wiki
# ops/production-tavya): every WAL segment within a minute, and a base backup
# each KARMAX_PG_BACKUP_INTERVAL_HOURS (24). The bucket must be the backups'
# own, with a lock rule so its key cannot delete or overwrite them and a
# lifecycle rule for retention; nothing here ever deletes from it. The key
# comes from KARMAX_PG_BACKUP_ACCESS_KEY_ID and KARMAX_PG_BACKUP_SECRET_ACCESS_KEY,
# so it never appears in a process list. PUBLIC_KEY is the armored OpenPGP
# public key backups are encrypted to; its private half restores them and
# must stay off this host.
cmd_configure_backups() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  [ "$#" -eq 3 ] || die 'usage: ./deploy/karmax configure-backups s3://BUCKET/PREFIX https://ENDPOINT PUBLIC_KEY'
  prefix=$1; endpoint=$2; public_key=$3
  printf '%s' "$prefix" | grep -Eq '^s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9._-]+)+$' \
    || die "the prefix must look like s3://bucket/installation, not $prefix"
  case "$endpoint" in https://*) ;; *) die "the endpoint must be an https:// URL, not $endpoint" ;; esac
  grep -q 'BEGIN PGP PUBLIC KEY BLOCK' "$public_key" 2>/dev/null || die "$public_key is not an armored OpenPGP public key"
  ! grep -q 'PRIVATE KEY' "$public_key" || die "$public_key holds a private key: give this host only the public key"
  [ -n "${KARMAX_PG_BACKUP_ACCESS_KEY_ID:-}" ] && [ -n "${KARMAX_PG_BACKUP_SECRET_ACCESS_KEY:-}" ] \
    || die 'set KARMAX_PG_BACKUP_ACCESS_KEY_ID and KARMAX_PG_BACKUP_SECRET_ACCESS_KEY to the backup bucket key'
  ensure_secrets || die 'could not prepare the secrets directory'
  ( umask 077
    printf '%s\n' "$KARMAX_PG_BACKUP_ACCESS_KEY_ID" > "$SECRETS_DIR/pg_backup_access_key_id"
    printf '%s\n' "$KARMAX_PG_BACKUP_SECRET_ACCESS_KEY" > "$SECRETS_DIR/pg_backup_secret_access_key"
    cp "$public_key" "$SECRETS_DIR/pg_backup_public_key" ) || die 'could not write the backup secrets'
  secret_mode "$SECRETS_DIR/pg_backup_access_key_id" "$SECRETS_DIR/pg_backup_secret_access_key" "$SECRETS_DIR/pg_backup_public_key"
  staged="$ENV_FILE.backups.$$"
  if ! (umask 077 && { sed -e '/^KARMAX_PG_BACKUP_PREFIX=/d' -e '/^KARMAX_PG_BACKUP_ENDPOINT=/d' "$ENV_FILE" \
      && printf 'KARMAX_PG_BACKUP_PREFIX=%s\nKARMAX_PG_BACKUP_ENDPOINT=%s\n' "$prefix" "$endpoint"; } > "$staged"); then
    rm -f "$staged"; die 'could not stage the backup settings; nothing was changed'
  fi
  mv "$staged" "$ENV_FILE"
  note 'Restarting PostgreSQL with WAL archiving to the bucket, and starting base backups…'
  dc up -d --remove-orphans
  wait_ready || die 'Karmax failed its readiness check after enabling backups'
  note 'The first base backup is starting now (./deploy/karmax logs pg-backup); doctor passes once it is in the bucket.'
}

# Point-in-time restore of the off-host backups into a scratch volume, never
# into production: the copy cannot archive, has no network listener, and is
# deleted afterwards unless --keep. It prints what it recovered. TIME is
# PostgreSQL's timestamptz syntax (e.g. "2026-10-08 12:00:00+00"); without it,
# everything archived is replayed. The private key is the off-host one.
cmd_pg_restore() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  [ -n "$(env_value KARMAX_PG_BACKUP_PREFIX)" ] || die 'off-host backups are not configured here'
  target='' private_key='' keep=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --to) target=${2:?--to needs a time}; shift 2 ;;
      --private-key) private_key=${2:?--private-key needs a file}; shift 2 ;;
      --keep) keep=1; shift ;;
      *) die "unknown pg-restore option: $1" ;;
    esac
  done
  [ -n "$private_key" ] || die 'usage: ./deploy/karmax pg-restore --private-key FILE [--to TIME] [--keep]'
  grep -q 'BEGIN PGP PRIVATE KEY BLOCK' "$private_key" 2>/dev/null || die "$private_key is not an armored OpenPGP private key"
  volume="karmax-pitr-$(date -u +%Y%m%dT%H%M%SZ)"
  keydir=$(mktemp -d)
  chmod 700 "$keydir"
  # Readable by the container's postgres user; the 0700 directory keeps
  # everyone else on the host out, and it is removed on every exit.
  cp "$private_key" "$keydir/private.asc" && chmod 644 "$keydir/private.asc" || die 'could not stage the private key'
  trap 'rm -rf "$keydir"; [ -n "$keep" ] || docker volume rm -f "$volume" >/dev/null 2>&1 || true' EXIT
  docker volume create "$volume" >/dev/null
  note "Restoring ${target:+to $target }into the scratch volume $volume…"
  # shellcheck disable=SC2016 # expanded by the container's shell
  dc run --rm --no-deps -T --user root -v "$volume:/restore" -v "$keydir/private.asc:/run/pitr/private.asc:ro" \
    -e KARMAX_PG_BACKUP_PRIVATE_KEY=/run/pitr/private.asc -e PGDATA=/restore/data -e TARGET="$target" \
    --entrypoint sh pg-backup -c 'install -d -o postgres -g postgres -m 700 /restore/data \
      && exec gosu postgres karmax-pg-backup restore ${TARGET:+--to "$TARGET"}' < /dev/null \
    || die 'the point-in-time restore failed; see above'
  if [ -n "$keep" ]; then note "Kept the restored data directory in volume $volume (data/); remove it with docker volume rm $volume."
  else note 'Restore verified; the scratch volume is removed.'
  fi
}

