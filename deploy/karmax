#!/bin/sh
# Turnkey Karmax control-plane operator. Requires only Docker with Compose.
set -eu

# The detached update runner executes a copy of this file from
# deploy/.updates/<key>/ and names the instance it belongs to.
DEPLOY_DIR=${KARMAX_DEPLOY_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
ROOT_DIR=$(dirname "$DEPLOY_DIR")
ENV_FILE="$DEPLOY_DIR/.turnkey.env"
SECRETS_DIR="$DEPLOY_DIR/.secrets"
COMPOSE_FILE="$DEPLOY_DIR/compose.turnkey.yml"

die() { echo "karmax: $*" >&2; exit 1; }
note() { echo "• $*"; }
dc() { docker compose --project-directory "$DEPLOY_DIR" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"; }

backup_checksums() (
  destination=$1
  (cd "$destination" && sha256sum *.dump deployment-secrets/* > SHA256SUMS)
)

compact_backups() {
  # Optional space optimization must never invalidate a verified backup or
  # prevent an emergency deployment on a host without util-linux hardlink.
  sh "$DEPLOY_DIR/compact-backups.sh" "$DEPLOY_DIR/backups" || note 'Backup compaction failed; snapshots are retained.'
}

need_docker() {
  command -v docker >/dev/null 2>&1 || die 'Docker is required: https://docs.docker.com/engine/install/'
  docker compose version >/dev/null 2>&1 || die 'Docker Compose v2 is required (the `docker compose` command)'
  docker info >/dev/null 2>&1 || die 'Docker is not running, or this user cannot access it'
}

valid_domain() {
  case "$1" in
    ''|*://*|*/*|*:*|.*|*..*|*.) return 1 ;;
    *[!A-Za-z0-9.-]*) return 1 ;;
  esac
  printf '%s\n' "$1" | awk -F. '
    length($0) > 253 || NF < 2 { exit 1 }
    { for (i=1; i<=NF; i++) if (length($i) > 63 || $i !~ /^[A-Za-z0-9][A-Za-z0-9-]*[A-Za-z0-9]$/ && $i !~ /^[A-Za-z0-9]$/) exit 1 }
  '
}

env_value() {
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

random_hex() { od -An -N"${1:-48}" -tx1 /dev/urandom | tr -d ' \n'; }

# Compose bind-mounts these files into the app container with their host
# ownership intact, and that container runs as its own unprivileged uid (see
# deploy/Dockerfile) which matches no host user — so a 0600 secret is
# unreadable exactly where it is needed. $SECRETS_DIR stays 0700, which is what
# actually keeps other users on the host out: they cannot traverse into it.
secret_mode() { chmod 644 "$@"; }

write_secret() {
  file="$SECRETS_DIR/$1"
  [ -s "$file" ] || random_hex 48 > "$file"
  secret_mode "$file"
}

# Every secret compose.turnkey.yml mounts; existing ones are kept. Updates and
# restores call this too, so a release that mounts a new secret can start.
# A subshell, so the umask cannot reach files a later checkout writes.
ensure_secrets() (
  umask 077
  mkdir -p "$SECRETS_DIR"
  chmod 700 "$SECRETS_DIR"
  write_secret auth_secret
  write_secret vault_key
  write_secret world_ref_key
  # The app's own PostgreSQL login, not the superuser (postgres/karmax-role.sh).
  file="$SECRETS_DIR/database_url"
  [ -s "$file" ] || printf 'postgres://karmax:%s@postgresql:5432/karmax\n' "$(random_hex 32)" > "$file"
  secret_mode "$file"
)

configure() {
  requested_domain=${1:-}
  existing_domain=$(env_value KARMAX_DOMAIN)
  domain=${requested_domain:-$existing_domain}
  [ -n "$domain" ] || die 'usage: ./deploy/karmax up karmax.example.com [preview.example.com]'
  domain=$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]')
  valid_domain "$domain" || die "invalid domain: $domain"
  if [ -n "${2:-}" ]; then preview=$2
  elif [ -n "$requested_domain" ] && [ "$domain" != "$existing_domain" ]; then preview="preview.$domain"
  else preview=$(env_value KARMAX_PREVIEW_DOMAIN)
  fi
  [ -n "$preview" ] || preview="preview.$domain"
  preview=$(printf '%s' "$preview" | tr '[:upper:]' '[:lower:]')
  valid_domain "$preview" || die "invalid preview domain: $preview"
  [ "$domain" != "$preview" ] || die 'the preview domain must be different from the application domain'

  legacy=$(env_value KARMAX_LEGACY_DOMAIN)
  if [ -z "$legacy" ] && [ -n "$existing_domain" ] && [ "$domain" != "$existing_domain" ]; then
    legacy=$existing_domain
  fi
  if [ -n "$legacy" ]; then
    legacy=$(printf '%s' "$legacy" | tr '[:upper:]' '[:lower:]')
    valid_domain "$legacy" || die "invalid legacy domain: $legacy"
    [ "$legacy" != "$domain" ] || legacy=''
  fi

  old_password=$(env_value POSTGRES_PASSWORD)
  password=${old_password:-$(random_hex 32)}
  old_provider=$(env_value KARMAX_CLOUD_WORLD_PROVIDER)
  provider=${old_provider:-e2b}
  old_temporal=$(env_value TEMPORAL_VERSION)
  temporal=${old_temporal:-1.31.0}
  old_postgres=$(env_value POSTGRES_VERSION)
  postgres=${old_postgres:-16}

  # This file is rewritten wholesale below, so anything the managed keys
  # above do not carry over is deleted. Operators legitimately add their own
  # settings here (a social OAuth client, a mailer), and losing one at the next
  # `up` is invisible: no error, the feature just quietly stops existing. So
  # capture every other assignment now, before the truncation, and re-emit it.
  carried=''
  if [ -f "$ENV_FILE" ]; then
    carried=$(awk '
      BEGIN { split("KARMAX_DOMAIN KARMAX_PREVIEW_DOMAIN KARMAX_LEGACY_DOMAIN KARMAX_LEGACY_WWW_DOMAIN KARMAX_PENDING_DOMAIN KARMAX_PENDING_PREVIEW_DOMAIN KARMAX_CLOUD_WORLD_PROVIDER \
        POSTGRES_PASSWORD TEMPORAL_VERSION POSTGRES_VERSION", m, " ")
        for (i in m) managed[m[i]] = 1 }
      /^[A-Za-z_][A-Za-z0-9_]*=/ {
        if (!((key = substr($0, 1, index($0, "=") - 1)) in managed)) print
      }' "$ENV_FILE")
  fi

  umask 077
  ensure_secrets
  {
    printf 'KARMAX_DOMAIN=%s\n' "$domain"
    printf 'KARMAX_PREVIEW_DOMAIN=%s\n' "$preview"
    if [ -n "$legacy" ]; then
      printf 'KARMAX_LEGACY_DOMAIN=%s\n' "$legacy"
      printf 'KARMAX_LEGACY_WWW_DOMAIN=www.%s\n' "$legacy"
    fi
    printf 'KARMAX_CLOUD_WORLD_PROVIDER=%s\n' "$provider"
    printf 'POSTGRES_PASSWORD=%s\n' "$password"
    printf 'TEMPORAL_VERSION=%s\n' "$temporal"
    printf 'POSTGRES_VERSION=%s\n' "$postgres"
    [ -z "$carried" ] || printf '%s\n' "$carried"
  } > "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

wait_ready() {
  note 'Waiting for the Karmax control plane to become ready…'
  attempt=0
  until dc exec -T app node -e "fetch('http://127.0.0.1:4505/api/health/ready',{signal:AbortSignal.timeout(5000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 90 ]; then
      dc ps
      dc logs --tail=100 app temporal >&2 || true
      echo 'karmax: Karmax did not become ready; the diagnostic logs are above' >&2
      return 1
    fi
    sleep 2
  done
}

print_finish() {
  domain=$(env_value KARMAX_DOMAIN)
  preview=$(env_value KARMAX_PREVIEW_DOMAIN)
  cat <<EOF

Karmax is ready: https://$domain

DNS must point at this VPS:
  A/AAAA  $domain
  A/AAAA  *.$preview

Caddy obtains and renews HTTPS certificates automatically. Open Karmax, create
the first administrator, then connect GitHub and E2B or Daytona in Organization
settings. No provider secrets or GitHub keys belong in this file.
EOF
}

cmd_up() {
  need_docker
  configure "${1:-}" "${2:-}"
  dc config --quiet
  note 'Building and starting PostgreSQL, Temporal, Karmax, and Caddy…'
  dc up -d --build --remove-orphans
  wait_ready || die 'Karmax failed its readiness check'
  print_finish
}

cmd_doctor() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured; run `./deploy/karmax up your-domain`'
  dc config --quiet
  note 'Compose configuration is valid.'
  for secret in auth_secret vault_key world_ref_key database_url; do
    [ -s "$SECRETS_DIR/$secret" ] || die "missing secret: $secret"
  done
  note 'Durable secrets are present.'
  dc ps
  domain=$(env_value KARMAX_DOMAIN)
  if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 10 "https://$domain/api/health/ready" >/dev/null 2>&1; then
    note "Public HTTPS health check passed for $domain."
  else
    note "Public HTTPS is not reachable yet. Check DNS for $domain and ports 80/443."
  fi
}

cmd_backup() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  destination=${1:-"$DEPLOY_DIR/backups/$stamp"}
  case "$destination" in /*) ;; *) destination="$PWD/$destination" ;; esac
  [ ! -e "$destination" ] || die "backup destination already exists: $destination"
  staging="$destination.partial.$$"
  [ ! -e "$staging" ] || die "backup staging path already exists: $staging"
  mkdir -p "$(dirname "$destination")"
  mkdir "$staging"
  chmod 700 "$staging"
  trap 'rm -rf "$staging"' EXIT
  temporary="/tmp/karmax-control-plane-$stamp"
  note 'Taking an online Karmax snapshot…'
  # The app is intentionally live here: SQLite uses its online backup API, and
  # the remaining components are copied before the PostgreSQL dumps below.
  # createBackup requires callers to acknowledge that those component snapshots
  # are not all taken at one instant; without this flag every automated update
  # fails before it can pull the commit that would fix the updater.
  dc exec -T app npm run backup -- --allow-running "$temporary"
  dc cp "app:$temporary" "$staging/control-plane"
  dc exec -T app rm -rf "$temporary"
  note 'Dumping Karmax and Temporal PostgreSQL data…'
  dc exec -T postgresql pg_dump -U temporal -Fc karmax > "$staging/karmax.dump"
  dc exec -T postgresql pg_dump -U temporal -Fc temporal > "$staging/temporal.dump"
  dc exec -T postgresql pg_dump -U temporal -Fc temporal_visibility > "$staging/temporal-visibility.dump"
  cp -R "$SECRETS_DIR" "$staging/deployment-secrets"
  backup_checksums "$staging"
  chmod -R go-rwx "$staging"
  mv "$staging" "$destination"
  trap - EXIT
  note "Backup complete: $destination"
  note 'Treat it as highly sensitive: it contains the encrypted vault and its decryption key.'
  compact_backups
}

# Pre-update snapshots must run the backup code from the validated candidate,
# not `docker compose exec` inside the old live app. Otherwise an updater can
# never deploy a fix for a bug in the backup path: the old bug blocks the new
# image before it is allowed to start. The one-off candidate shares the durable
# volume while the existing service remains untouched.
cmd_backup_candidate() {
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  destination="$DEPLOY_DIR/backups/predeploy-$stamp"
  [ ! -e "$destination" ] || die "backup destination already exists: $destination"
  mkdir -p "$destination"
  chmod 700 "$destination"
  temporary="/var/lib/karmax/backups/predeploy-$stamp-$$"
  note 'Taking an online Karmax snapshot with the validated candidate…'
  if ! dc run --rm --no-deps app npm run backup -- --allow-running "$temporary"; then
    rm -rf "$destination"
    dc exec -T app rm -rf "$temporary" >/dev/null 2>&1 || true
    return 1
  fi
  if ! dc cp "app:$temporary" "$destination/control-plane"; then
    rm -rf "$destination"
    dc exec -T app rm -rf "$temporary" >/dev/null 2>&1 || true
    return 1
  fi
  if ! dc exec -T app rm -rf "$temporary"; then rm -rf "$destination"; return 1; fi
  note 'Dumping PostgreSQL data…'
  # The first deployment of PostgreSQL support still has all authoritative
  # application state in the SQLite files captured above; its karmax database
  # does not exist until the new schema job runs. Every later update must dump it.
  if dc exec -T postgresql psql -U temporal -d postgres -Atqc "SELECT 1 FROM pg_database WHERE datname='karmax'" | grep -q 1; then
    if ! dc exec -T postgresql pg_dump -U temporal -Fc karmax > "$destination/karmax.dump"; then
      rm -rf "$destination"; return 1
    fi
  fi
  if ! dc exec -T postgresql pg_dump -U temporal -Fc temporal > "$destination/temporal.dump"; then
    rm -rf "$destination"; return 1
  fi
  if ! dc exec -T postgresql pg_dump -U temporal -Fc temporal_visibility > "$destination/temporal-visibility.dump"; then
    rm -rf "$destination"; return 1
  fi
  if ! cp -R "$SECRETS_DIR" "$destination/deployment-secrets"; then rm -rf "$destination"; return 1; fi
  if ! backup_checksums "$destination"; then rm -rf "$destination"; return 1; fi
  if ! chmod -R go-rwx "$destination"; then rm -rf "$destination"; return 1; fi
  note "Backup complete: $destination"
  note 'Treat it as highly sensitive: it contains the encrypted vault and its decryption key.'
  compact_backups
}

cmd_restore() {
  need_docker
  source=${1:-}
  [ -n "$source" ] || die 'usage: ./deploy/karmax restore /path/to/backup'
  case "$source" in /*) ;; *) source="$PWD/$source" ;; esac
  [ -f "$source/control-plane/manifest.json" ] || die 'backup is missing control-plane/manifest.json'
  [ -f "$source/temporal.dump" ] || die 'backup is missing temporal.dump'
  [ -f "$source/temporal-visibility.dump" ] || die 'backup is missing temporal-visibility.dump'
  [ -d "$source/deployment-secrets" ] || die 'backup is missing deployment-secrets'
  [ -f "$ENV_FILE" ] || die 'configure the destination first with `./deploy/karmax up your-domain`'
  [ -f "$source/SHA256SUMS" ] || die 'backup is missing checksums; cannot verify before restore'
  (cd "$source" && sha256sum -c SHA256SUMS) || die 'backup checksum verification failed'
  # Check the control-plane manifest and every payload file using the candidate
  # app, while the live containers and all three databases are still untouched.
  dc build app
  dc run --rm --no-deps -v "$source/control-plane:/restore:ro" app npm run restore -- --verify /restore \
    || die 'control-plane backup verification failed'
  for dump in karmax temporal temporal-visibility; do
    [ -f "$source/$dump.dump" ] || { [ "$dump" = karmax ] && continue; die "backup is missing $dump.dump"; }
    dc run --rm --no-deps -T postgresql pg_restore -f /dev/null < "$source/$dump.dump" \
      || die "PostgreSQL dump verification failed: $dump.dump"
  done
  echo "This replaces Karmax and Temporal data on this instance with: $source"
  printf 'Type RESTORE to continue: '
  read answer
  [ "$answer" = RESTORE ] || die 'restore cancelled'

  dc down
  rm -rf "$SECRETS_DIR"
  cp -R "$source/deployment-secrets" "$SECRETS_DIR"
  chmod 700 "$SECRETS_DIR"
  secret_mode "$SECRETS_DIR"/*
  # A backup taken before a secret existed restores without it.
  ensure_secrets
  dc up -d postgresql
  attempt=0
  until dc exec -T postgresql pg_isready -U temporal -d postgres >/dev/null 2>&1; do
    attempt=$((attempt + 1)); [ "$attempt" -lt 60 ] || die 'PostgreSQL did not become ready'; sleep 2
  done
  for database in karmax temporal temporal_visibility; do
    dc exec -T postgresql dropdb --if-exists -U temporal --force "$database"
    dc exec -T postgresql createdb -U temporal "$database"
  done
  if [ -f "$source/karmax.dump" ]; then
    dc exec -T postgresql pg_restore -U temporal -d karmax < "$source/karmax.dump"
  fi
  dc exec -T postgresql pg_restore -U temporal -d temporal < "$source/temporal.dump"
  dc exec -T postgresql pg_restore -U temporal -d temporal_visibility < "$source/temporal-visibility.dump"
  dc run --rm --no-deps -v "$source/control-plane:/restore:ro" app npm run restore -- /restore
  dc up -d --remove-orphans
  wait_ready || die 'Karmax failed its readiness check after restore'
  note 'Restore complete.'
  print_finish
}

# A data epoch is a code-only rollback compatibility boundary, not a schema
# version. Missing markers are legacy epoch 1; malformed markers fail closed.
data_epoch() {
  if git -C "$ROOT_DIR" cat-file -e "$1:deploy/data-epoch" 2>/dev/null; then
    epoch=$(git -C "$ROOT_DIR" show "$1:deploy/data-epoch") || return 1
  else
    epoch=1
  fi
  case "$epoch" in ''|*[!0-9]*) return 1 ;; esac
  [ "$epoch" -ge 1 ] 2>/dev/null || return 1
  printf '%s\n' "$epoch"
}

cmd_update() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  requested=${1:-origin/master}
  case "$requested" in -*) die "invalid deployment revision: $requested" ;; esac
  git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die 'the deployment source is not a Git checkout'
  if [ -n "$(git -C "$ROOT_DIR" status --porcelain --untracked-files=no)" ]; then
    git -C "$ROOT_DIR" status --short --untracked-files=no >&2
    die 'the source checkout has local changes, so it cannot deploy an exact validated revision'
  fi

  # Resolve after fetching, but deploy the caller's immutable SHA — never
  # whatever happens to be at master by the time a slow CI run reaches SSH.
  git -C "$ROOT_DIR" fetch --prune origin master
  target=$(git -C "$ROOT_DIR" rev-parse --verify "$requested^{commit}") \
    || die "deployment revision does not exist: $requested"
  upstream=$(git -C "$ROOT_DIR" rev-parse --verify 'origin/master^{commit}')
  git -C "$ROOT_DIR" merge-base --is-ancestor "$target" "$upstream" \
    || die "refusing to deploy $target because it is not on origin/master"
  previous=$(git -C "$ROOT_DIR" rev-parse --verify HEAD)

  # A delayed older workflow must never roll production backward after a newer
  # validated revision has already landed.
  if [ "$previous" != "$target" ] && git -C "$ROOT_DIR" merge-base --is-ancestor "$target" "$previous"; then
    note "Skipping superseded deployment $target; production source is already at $previous."
    return 0
  fi
  git -C "$ROOT_DIR" merge-base --is-ancestor "$previous" "$target" \
    || [ "$previous" = "$target" ] \
    || die "deployment source $previous and requested revision $target have diverged"

  previous_epoch=$(data_epoch "$previous") || die "invalid data epoch in $previous"
  target_epoch=$(data_epoch "$target") || die "invalid data epoch in $target"
  [ "$target_epoch" -ge "$previous_epoch" ] || die "refusing data epoch downgrade $previous_epoch -> $target_epoch"

  # A domain migration can be staged in the environment without changing the
  # running service. The first validated update that understands these keys
  # applies it together with the new application/Caddy revision, so there is no
  # interval where the new origin serves an old, differently branded build.
  # Keep an exact copy because the normal deployment rollback must restore the
  # old origin as well as the old source and image.
  migration_backup=''
  restore_migration() {
    [ -z "$migration_backup" ] || [ ! -f "$migration_backup" ] || cp -p "$migration_backup" "$ENV_FILE"
  }
  cleanup_migration() {
    [ -z "$migration_backup" ] || rm -f "$migration_backup"
  }
  # Never discard the only pre-migration configuration on an unexpected error.
  # Explicit rollback/success paths below remove it only after reconciliation.
  migration_exit() {
    if [ -n "$migration_backup" ] && [ -f "$migration_backup" ]; then
      restore_migration
      note "Migration interrupted; original environment restored. Recovery copy: $migration_backup"
    fi
  }
  trap migration_exit EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  pending_domain=$(env_value KARMAX_PENDING_DOMAIN)
  pending_preview=$(env_value KARMAX_PENDING_PREVIEW_DOMAIN)
  if [ -n "$pending_domain" ]; then
    migration_backup="$ENV_FILE.migration.$$"
    cp -p "$ENV_FILE" "$migration_backup"
    configure "$pending_domain" "$pending_preview"
    note "Staged domain migration to $pending_domain for this deployment."
  fi

  note "Checking out validated revision $target…"
  git -C "$ROOT_DIR" checkout --detach "$target"
  # This file is the target's own, so it knows every secret the target mounts.
  ensure_secrets

  # Building does not replace the running container. It gives the one-off
  # snapshot process the candidate's backup implementation while production
  # continues serving the previous image.
  if ! dc build --pull app; then
    git -C "$ROOT_DIR" checkout --detach "$previous"
    restore_migration
    cleanup_migration
    migration_backup=''
    die "deployment $target could not be built; production remains at $previous"
  fi
  if ! cmd_backup_candidate; then
    git -C "$ROOT_DIR" checkout --detach "$previous"
    restore_migration
    dc build app || true
    cleanup_migration
    migration_backup=''
    die "deployment $target could not be backed up; production remains at $previous"
  fi

  if dc up -d --remove-orphans && wait_ready; then
    cleanup_migration
    migration_backup=''
    note "Update complete at $target."
    return 0
  fi

  # Candidate startup can change durable data and advance Temporal histories.
  # Reverting only code across an incompatible boundary would hide or overwrite
  # data. Preserve the candidate/data and stop serving instead; recovery must
  # repair forward or explicitly restore a coordinated pre-update backup.
  if [ "$previous_epoch" != "$target_epoch" ]; then
    dc stop app || die "deployment $target failed across data epochs; could not stop the app; manual recovery required"
    die "deployment $target failed across data epochs $previous_epoch -> $target_epoch; app stopped, data retained, code-only rollback refused. Repair forward or restore the pre-update backup at $destination with its matching code and Temporal history"
  fi

  # The previous image may have been replaced under the Compose service tag, so
  # rebuild it from the previous exact source before bringing the service back.
  note "Deployment $target failed; rolling back to $previous…"
  git -C "$ROOT_DIR" checkout --detach "$previous"
  restore_migration
  if dc build app && dc up -d --remove-orphans && wait_ready; then
    cleanup_migration
    migration_backup=''
    die "deployment $target failed; production was restored to $previous"
  fi
  die "deployment $target failed and automatic rollback to $previous also failed"
}

usage() {
  cat <<'EOF'
Usage: ./deploy/karmax COMMAND

  up DOMAIN [PREVIEW-DOMAIN]  Configure or start the complete HTTPS stack
  doctor                       Validate configuration, containers, DNS, and HTTPS
  status                       Show service health
  logs [SERVICE]               Follow logs (app by default)
  backup [DIRECTORY]           Snapshot Karmax, object data, Temporal, and keys
  restore DIRECTORY            Verify and restore a complete snapshot
  update [REVISION]             Backup, deploy an exact master revision, and restart
  down                          Stop everything without deleting durable data
EOF
}

command=${1:-help}
[ "$#" -eq 0 ] || shift
case "$command" in
  up) cmd_up "$@" ;;
  doctor) cmd_doctor "$@" ;;
  status) need_docker; [ -f "$ENV_FILE" ] || die 'not configured'; dc ps ;;
  logs) need_docker; [ -f "$ENV_FILE" ] || die 'not configured'; dc logs -f --tail=200 "${1:-app}" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  update) cmd_update "$@" ;;
  down) need_docker; [ -f "$ENV_FILE" ] || die 'not configured'; dc down ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
