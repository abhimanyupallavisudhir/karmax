# The resource repositories' edge: a Cloudflare Worker that sandboxes save
# resources through, so the bytes go into storage without passing through this
# host (wiki features/resource-storage). Takes CLOUDFLARE_API_TOKEN (Workers
# Scripts: Edit) from the environment and stores it nowhere; the account is
# CLOUDFLARE_ACCOUNT_ID, else the managed R2 bucket's. Repeatable: also how a
# changed Worker reaches Cloudflare. Records the URL as KARMAX_RESOURCE_EDGE_URL
# and restarts the app when it changed; deleting that line from .turnkey.env
# (and restarting) turns the edge off.
cmd_deploy_repository_edge() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  [ -n "${CLOUDFLARE_API_TOKEN:-}" ] || die 'set CLOUDFLARE_API_TOKEN (Workers Scripts: Edit)'
  output=$(dc run --rm --no-deps -T -e CLOUDFLARE_API_TOKEN -e CLOUDFLARE_ACCOUNT_ID app npm run --silent deploy-repository-edge < /dev/null) \
    || die 'the edge was not deployed; see above'
  url=$(printf '%s\n' "$output" | tail -n 1)
  case "$url" in https://*.workers.dev) ;; *) die "unexpected edge URL: $url" ;; esac
  note "Deployed the resource repository edge at $url."
  [ "$(env_value KARMAX_RESOURCE_EDGE_URL)" != "$url" ] || return 0
  staged="$ENV_FILE.edge.$$"
  if ! (umask 077 && { sed '/^KARMAX_RESOURCE_EDGE_URL=/d' "$ENV_FILE" && printf 'KARMAX_RESOURCE_EDGE_URL=%s\n' "$url"; } > "$staged"); then
    rm -f "$staged"; die 'could not record the edge URL; nothing was changed'
  fi
  mv "$staged" "$ENV_FILE"
  note 'Restarting the app with it…'
  dc up -d --no-build app && wait_ready || die 'Karmax failed its readiness check after enabling the edge'
  note 'Sandboxes now save resources through the edge.'
}

# Agent mail's inbound edge: a Cloudflare Email Worker that Email Routing's
# catch-all rule for DOMAIN (e.g. mail.example.com) hands every message to; it
# posts each one to the app, signed with a key derived from auth_secret, which
# goes up as a Worker secret (wiki features/agent-mail). Takes
# CLOUDFLARE_API_TOKEN (Workers Scripts: Edit) from the environment and stores
# it nowhere. Records DOMAIN as KARMAX_AGENT_MAIL_DOMAIN, so every organization
# without its own mail provider gets agent-<token>@DOMAIN, and restarts the app
# when it changed. Repeatable. Email Routing itself (MX records, the catch-all
# rule naming the Worker) is configured on the zone, not here.
cmd_deploy_agent_mail_edge() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  [ "$#" -eq 1 ] || die 'usage: ./deploy/karmax deploy-agent-mail-edge mail.example.com'
  domain=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  valid_domain "$domain" || die "invalid mail domain: $domain"
  [ "$domain" != "$(env_value KARMAX_DOMAIN)" ] || die 'agent mail needs a domain of its own, not the application domain'
  [ "$domain" != "$(env_value KARMAX_PREVIEW_DOMAIN)" ] || die 'agent mail needs a domain of its own, not the preview domain'
  [ -n "${CLOUDFLARE_API_TOKEN:-}" ] || die 'set CLOUDFLARE_API_TOKEN (Workers Scripts: Edit)'
  output=$(dc run --rm --no-deps -T -e CLOUDFLARE_API_TOKEN -e CLOUDFLARE_ACCOUNT_ID -e "KARMAX_AGENT_MAIL_DOMAIN=$domain" \
    app npm run --silent deploy-agent-mail-edge < /dev/null) || die 'the mail edge was not deployed; see above'
  script=$(printf '%s\n' "$output" | tail -n 1)
  case "$script" in tavya-agent-mail*) ;; *) die "unexpected answer: $script" ;; esac
  note "Deployed the agent mail Worker $script for @$domain. Email Routing's catch-all rule must send to it."
  [ "$(env_value KARMAX_AGENT_MAIL_DOMAIN)" != "$domain" ] || return 0
  staged="$ENV_FILE.mail.$$"
  if ! (umask 077 && { sed '/^KARMAX_AGENT_MAIL_DOMAIN=/d' "$ENV_FILE" && printf 'KARMAX_AGENT_MAIL_DOMAIN=%s\n' "$domain"; } > "$staged"); then
    rm -f "$staged"; die 'could not record the mail domain; nothing was changed'
  fi
  mv "$staged" "$ENV_FILE"
  note 'Restarting the app with it…'
  dc up -d --no-build app && wait_ready || die 'Karmax failed its readiness check after enabling agent mail'
  note "Organizations without their own mail provider now get addresses on $domain."
}

cmd_backup() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  # An operator's backup is named as one, so automatic pruning keeps it.
  destination=${1:-"$DEPLOY_DIR/backups/manual-$stamp"}
  case "$destination" in /*) ;; *) destination="$PWD/$destination" ;; esac
  [ ! -e "$destination" ] || die "backup destination already exists: $destination"
  staging="$destination.partial.$$"
  [ ! -e "$staging" ] || die "backup staging path already exists: $staging"
  mkdir -p "$(dirname "$destination")"
  mkdir "$staging"
  chmod 700 "$staging"
  trap 'rm -rf "$staging"' EXIT
  temporary="/tmp/karmax-control-plane-$stamp"
  note 'Taking an online Karmax snapshot…'
  # The app is intentionally live here: SQLite uses its online backup API, and
  # the remaining components are copied before the PostgreSQL dumps below.
  # createBackup requires callers to acknowledge that those component snapshots
  # are not all taken at one instant; without this flag every automated update
  # fails before it can pull the commit that would fix the updater.
  dc exec -T app npm run backup -- --allow-running "$temporary"
  dc cp "app:$temporary" "$staging/control-plane"
  dc exec -T app rm -rf "$temporary"
  note 'Dumping Karmax and Temporal PostgreSQL data…'
  dc exec -T postgresql pg_dump -U temporal -Fc karmax > "$staging/karmax.dump"
  dc exec -T postgresql pg_dump -U temporal -Fc temporal > "$staging/temporal.dump"
  dc exec -T postgresql pg_dump -U temporal -Fc temporal_visibility > "$staging/temporal-visibility.dump"
  copy_deployment_secrets "$staging/deployment-secrets"
  backup_checksums "$staging"
  sign_checksums "$staging" exec -T app
  chmod -R go-rwx "$staging"
  mv "$staging" "$destination"
  trap - EXIT
  note "Backup complete: $destination"
  backup_notice
  compact_backups
}

# Pre-update snapshots must run the backup code from the validated candidate,
# not `docker compose exec` inside the old live app. Otherwise an updater can
# never deploy a fix for a bug in the backup path: the old bug blocks the new
# image before it is allowed to start. The one-off candidate shares the durable
# volume while the existing service remains untouched.
cmd_backup_candidate() {
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  destination="$DEPLOY_DIR/backups/predeploy-$stamp"
  [ ! -e "$destination" ] || die "backup destination already exists: $destination"
  mkdir -p "$destination"
  chmod 700 "$destination"
  temporary="/var/lib/karmax/backups/predeploy-$stamp-$$"
  note 'Taking an online Karmax snapshot with the validated candidate…'
  if ! dc run --rm --no-deps app npm run backup -- --allow-running "$temporary"; then
    rm -rf "$destination"
    dc exec -T app rm -rf "$temporary" >/dev/null 2>&1 || true
    return 1
  fi
  if ! dc cp "app:$temporary" "$destination/control-plane"; then
    rm -rf "$destination"
    dc exec -T app rm -rf "$temporary" >/dev/null 2>&1 || true
    return 1
  fi
  if ! dc exec -T app rm -rf "$temporary"; then rm -rf "$destination"; return 1; fi
  note 'Dumping PostgreSQL data…'
  # The first deployment of PostgreSQL support still has all authoritative
  # application state in the SQLite files captured above; its karmax database
  # does not exist until the new schema job runs. Every later update must dump it.
  if dc exec -T postgresql psql -U temporal -d postgres -Atqc "SELECT 1 FROM pg_database WHERE datname='karmax'" | grep -q 1; then
    if ! dc exec -T postgresql pg_dump -U temporal -Fc karmax > "$destination/karmax.dump"; then
      rm -rf "$destination"; return 1
    fi
  fi
  if ! dc exec -T postgresql pg_dump -U temporal -Fc temporal > "$destination/temporal.dump"; then
    rm -rf "$destination"; return 1
  fi
  if ! dc exec -T postgresql pg_dump -U temporal -Fc temporal_visibility > "$destination/temporal-visibility.dump"; then
    rm -rf "$destination"; return 1
  fi
  if ! copy_deployment_secrets "$destination/deployment-secrets"; then rm -rf "$destination"; return 1; fi
  if ! backup_checksums "$destination"; then rm -rf "$destination"; return 1; fi
  if ! sign_checksums "$destination" run --rm --no-deps -T app; then rm -rf "$destination"; return 1; fi
  if ! chmod -R go-rwx "$destination"; then rm -rf "$destination"; return 1; fi
  note "Backup complete: $destination"
  backup_notice
}

backup_notice() {
  note 'It holds the encrypted vault but not its key: restoring it needs deploy/.secrets/vault_key, so keep a copy of that key off-host.'
  note 'Still treat it as sensitive: it holds the auth secret, provider logins and the database dumps.'
}

cmd_restore() {
  need_docker
  # Backups are signed (DB-10). --trust-key names the fingerprint of the key
  # that signed one taken on another host; --accept-unsigned-v1 restores one
  # from before signing, which nothing can authenticate, and is audited.
  # Backups do not carry the vault key (SS-2): --vault-key names a copy of the
  # deploy/.secrets/vault_key the backup was taken under (kept off-host, or a
  # vault_key.retired-* after a rotation); without it the live key is used.
  trust='' unsigned='' vault_key=''
  while [ "$#" -gt 1 ]; do
    case "$1" in
      --trust-key)
        case "${2:-}" in SHA256:[A-Za-z0-9+/]*) ;; *) die '--trust-key needs a SHA256:… key fingerprint' ;; esac
        trust="$trust --trust-key $2"; shift 2 ;;
      --accept-unsigned-v1) unsigned=' --accept-unsigned-v1'; shift ;;
      --vault-key)
        [ -s "${2:-}" ] || die '--vault-key needs a copy of the vault_key file the backup was taken under'
        vault_key=$2; shift 2 ;;
      *) break ;;
    esac
  done
  source=${1:-}
  [ -n "$source" ] || die 'usage: ./deploy/karmax restore [--trust-key SHA256:…] [--accept-unsigned-v1] [--vault-key FILE] /path/to/backup'
  case "$source" in /*) ;; *) source="$PWD/$source" ;; esac
  [ -d "$source" ] || die "backup not found: $source"
  [ -f "$ENV_FILE" ] || die 'configure the destination first with `./deploy/karmax up your-domain`'
  # Verify and restore a private copy, never the backup directory itself,
  # which could change between the check and the restore.
  stage=$(mktemp -d "$DEPLOY_DIR/.restore-stage.XXXXXX") || die 'could not create a private restore stage'
  trap 'rm -rf "$stage"' EXIT
  chmod 700 "$stage"
  cp -RP "$source/." "$stage/" || die "could not copy $source for verification"
  [ -z "$(find "$stage" -type l)" ] || die 'backup contains a symbolic link; refusing to restore it'
  echo "This replaces Karmax and Temporal data on this instance with: $source"
  source=$stage
  [ -f "$source/control-plane/manifest.json" ] || die 'backup is missing control-plane/manifest.json'
  [ -f "$source/temporal.dump" ] || die 'backup is missing temporal.dump'
  [ -f "$source/temporal-visibility.dump" ] || die 'backup is missing temporal-visibility.dump'
  [ -d "$source/deployment-secrets" ] || die 'backup is missing deployment-secrets'
  if [ -f "$source/SHA256SUMS" ]; then
    (cd "$source" && sha256sum -c SHA256SUMS) || die 'backup checksum verification failed'
  elif [ -n "$unsigned" ]; then
    # The previous release's updater wrote no checksums; its control plane is
    # still checked against its manifest, and every dump by pg_restore below.
    note 'This backup predates checksums: only its control plane and the readability of its dumps can be verified.'
  else
    die 'backup has no checksums (it predates them); restore it only if it stayed in trusted storage, with --accept-unsigned-v1'
  fi
  # The vault key the restored vault will open with: --vault-key, else the one
  # a backup from before SS-2 carries, else this instance's own. The checks
  # below refuse it unless the backup's vault is wrapped under it.
  candidate_key="$stage/.restore-vault-key"
  if [ -n "$vault_key" ]; then cp "$vault_key" "$candidate_key"
  elif [ -f "$source/deployment-secrets/vault_key" ]; then cp "$source/deployment-secrets/vault_key" "$candidate_key"
  else cp "$SECRETS_DIR/vault_key" "$candidate_key"
  fi || die 'could not stage the vault key'
  chmod 600 "$candidate_key"
  # Check both signatures, every checksum, the control-plane manifest, every
  # payload file and the vault key using the candidate app, while the live
  # containers and all three databases are still untouched.
  build_images
  # The backup is private to the operator who took it (0600) and the app image
  # runs as its own uid, so the one-offs that read it run as root. Their stdin
  # is closed so they cannot swallow the confirmation meant for the prompt.
  # shellcheck disable=SC2086 # fingerprints and flags are validated words
  dc run --rm --no-deps -T --user root -v "$source:/backup:ro" -e KARMAX_VAULT_KEY_FILE=/backup/.restore-vault-key \
    app npm run restore -- --verify-deployment --check-vault-key$trust$unsigned /backup \
    < /dev/null || die 'backup verification failed (a vault key it names is the wrong one: pass the right one with --vault-key FILE)'
  for dump in karmax temporal temporal-visibility; do
    [ -f "$source/$dump.dump" ] || { [ "$dump" = karmax ] && continue; die "backup is missing $dump.dump"; }
    dc run --rm --no-deps -T postgresql pg_restore -f /dev/null < "$source/$dump.dump" \
      || die "PostgreSQL dump verification failed: $dump.dump"
  done
  # Staging holds a second copy of every database beside the live ones, on the
  # disk that also takes the live write-ahead log, so filling it would stop the
  # running instance too. A database restores to at least the size of its
  # compressed dump, and usually a few times it.
  dumps_kb=$(du -k "$source"/*.dump | awk '{ total += $1 } END { print total + 0 }')
  free_kb=$(dc run --rm --no-deps -T postgresql df -Pk /var/lib/postgresql/data < /dev/null | awk 'NR == 2 { print $4 }')
  case "$free_kb" in
    ''|*[!0-9]*) note "Could not read the free space on PostgreSQL's disk." ;;
    *)
      [ "$free_kb" -ge "$dumps_kb" ] || die "not enough free space to stage the restore: PostgreSQL's disk has $((free_kb / 1024)) MiB free for $((dumps_kb / 1024)) MiB of dumps"
      [ "$free_kb" -ge $((dumps_kb * 4)) ] || echo "karmax: warning: the restored databases may not fit: PostgreSQL's disk has $((free_kb / 1024)) MiB free for $((dumps_kb / 1024)) MiB of dumps, which usually restore to a few times that. Running out would stop the running instance too." >&2
      ;;
  esac
  confirm=RESTORE
  if [ -n "$unsigned" ]; then
    echo 'This backup is unsigned: nothing proves it has not been altered since it was taken.'
    confirm='RESTORE UNSIGNED'
  fi
  printf 'Type %s to continue: ' "$confirm"
  read -r answer
  [ "$answer" = "$confirm" ] || die 'restore cancelled'

  # Nothing live changes until every database has been restored beside it,
  # into <name>_restore, and the secrets have been copied beside theirs. A dump
  # can fail only now: it may name a role this PostgreSQL does not have (a
  # fresh volume has no karmax role), so it is restored without owners or
  # grants; the karmax-database job hands everything to the app's role on the
  # next start. A failure here leaves the instance exactly as it was.
  staged_secrets="$SECRETS_DIR.restore.$$"
  drop_staging() {
    rm -rf "$staged_secrets"
    for database in karmax temporal temporal_visibility; do
      dc exec -T postgresql dropdb --if-exists -U temporal --force "${database}_restore" || true
    done
  }
  abandon() { drop_staging; die "$1; nothing on this instance was changed"; }
  cp -R "$source/deployment-secrets" "$staged_secrets" || abandon 'could not copy the deployment secrets'
  cp "$candidate_key" "$staged_secrets/vault_key" || abandon 'could not stage the vault key'
  # Keys retired by rotate-vault-key open the backups taken before the
  # rotation; a restore never discards them.
  for retired in "$SECRETS_DIR"/vault_key.retired-*; do
    [ ! -f "$retired" ] || cp -p "$retired" "$staged_secrets/" || abandon 'could not keep the retired vault keys'
  done
  chmod 700 "$staged_secrets" && secret_mode "$staged_secrets"/* || abandon 'could not protect the deployment secrets'
  dc up -d postgresql || abandon 'PostgreSQL did not start'
  attempt=0
  until dc exec -T postgresql pg_isready -U temporal -d postgres >/dev/null 2>&1; do
    attempt=$((attempt + 1)); [ "$attempt" -lt 60 ] || abandon 'PostgreSQL did not become ready'; sleep 2
  done
  for dump in karmax temporal temporal-visibility; do
    database=$(printf '%s' "$dump" | tr - _)_restore
    dc exec -T postgresql dropdb --if-exists -U temporal --force "$database" \
      && dc exec -T postgresql createdb -U temporal "$database" \
      || abandon "could not create $database"
    [ -f "$source/$dump.dump" ] || continue
    dc exec -T postgresql pg_restore -U temporal --no-owner --no-privileges -d "$database" < "$source/$dump.dump" \
      || abandon "$dump.dump did not restore"
  done

  dc down
  rm -rf "$SECRETS_DIR"
  mv "$staged_secrets" "$SECRETS_DIR"
  # A backup taken before a secret existed restores without it.
  ensure_secrets
  dc up -d postgresql
  attempt=0
  until dc exec -T postgresql pg_isready -U temporal -d postgres >/dev/null 2>&1; do
    attempt=$((attempt + 1)); [ "$attempt" -lt 60 ] || die 'PostgreSQL did not become ready'; sleep 2
  done
  for database in karmax temporal temporal_visibility; do
    dc exec -T postgresql dropdb --if-exists -U temporal --force "$database"
    dc exec -T postgresql psql -U temporal -d postgres -v ON_ERROR_STOP=1 \
      -c "ALTER DATABASE ${database}_restore RENAME TO $database"
  done
  # shellcheck disable=SC2086 # fingerprints and flags are validated words
  dc run --rm --no-deps -T --user root -v "$source/control-plane:/restore:ro" app \
    sh -c "npm run restore --$trust$unsigned /restore && chown -R karmax:karmax /var/lib/karmax"
  dc up -d --remove-orphans
  wait_ready || die 'Karmax failed its readiness check after restore'
  rm -rf "$stage"
  trap - EXIT
  note 'Restore complete.'
  print_finish
}

# A data epoch is a code-only rollback compatibility boundary, not a schema
# version. Missing markers are legacy epoch 1; malformed markers fail closed.
data_epoch() {
  if git -C "$ROOT_DIR" cat-file -e "$1:deploy/data-epoch" 2>/dev/null; then
    epoch=$(git -C "$ROOT_DIR" show "$1:deploy/data-epoch") || return 1
  else
    epoch=1
  fi
  case "$epoch" in ''|*[!0-9]*) return 1 ;; esac
  [ "$epoch" -ge 1 ] 2>/dev/null || return 1
  printf '%s\n' "$epoch"
}

cmd_update() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  accept_vault='' requested=''
  for argument in "$@"; do
    case "$argument" in
      --accept-vault-findings) accept_vault=1 ;;
      -*) die "unknown update option: $argument" ;;
      *) [ -z "$requested" ] || die "update takes one revision, not $requested and $argument"; requested=$argument ;;
    esac
  done
  requested=${requested:-origin/master}
  git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die 'the deployment source is not a Git checkout'
  if [ -n "$(git -C "$ROOT_DIR" status --porcelain --untracked-files=no)" ]; then
    git -C "$ROOT_DIR" status --short --untracked-files=no >&2
    die 'the source checkout has local changes, so it cannot deploy an exact validated revision'
  fi

  # Resolve after fetching, but deploy the caller's immutable SHA — never
  # whatever happens to be at master by the time a slow CI run reaches SSH.
  git -C "$ROOT_DIR" fetch --prune origin master
  target=$(git -C "$ROOT_DIR" rev-parse --verify "$requested^{commit}") \
    || die "deployment revision does not exist: $requested"
  upstream=$(git -C "$ROOT_DIR" rev-parse --verify 'origin/master^{commit}')
  git -C "$ROOT_DIR" merge-base --is-ancestor "$target" "$upstream" \
    || die "refusing to deploy $target because it is not on origin/master"
  previous=$(git -C "$ROOT_DIR" rev-parse --verify HEAD)

  # A delayed older workflow must never roll production backward after a newer
  # validated revision has already landed.
  if [ "$previous" != "$target" ] && git -C "$ROOT_DIR" merge-base --is-ancestor "$target" "$previous"; then
    note "Skipping superseded deployment $target; production source is already at $previous."
    return 0
  fi
  git -C "$ROOT_DIR" merge-base --is-ancestor "$previous" "$target" \
    || [ "$previous" = "$target" ] \
    || die "deployment source $previous and requested revision $target have diverged"

  previous_epoch=$(data_epoch "$previous") || die "invalid data epoch in $previous"
  target_epoch=$(data_epoch "$target") || die "invalid data epoch in $target"
  [ "$target_epoch" -ge "$previous_epoch" ] || die "refusing data epoch downgrade $previous_epoch -> $target_epoch"

  # A domain migration can be staged in the environment without changing the
  # running service. The first validated update that understands these keys
  # applies it together with the new application/Caddy revision, so there is no
  # interval where the new origin serves an old, differently branded build.
  # Keep an exact copy because the normal deployment rollback must restore the
  # old origin as well as the old source and image.
  migration_backup=''
  restore_migration() {
    [ -z "$migration_backup" ] || [ ! -f "$migration_backup" ] || cp -p "$migration_backup" "$ENV_FILE"
  }
  cleanup_migration() {
    [ -z "$migration_backup" ] || rm -f "$migration_backup"
  }
  # Never discard the only pre-migration configuration on an unexpected error.
  # Explicit rollback/success paths below remove it only after reconciliation.
  migration_exit() {
    if [ -n "$migration_backup" ] && [ -f "$migration_backup" ]; then
      restore_migration
      note "Migration interrupted; original environment restored. Recovery copy: $migration_backup"
    fi
  }
  trap migration_exit EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  pending_domain=$(env_value KARMAX_PENDING_DOMAIN)
  pending_preview=$(env_value KARMAX_PENDING_PREVIEW_DOMAIN)
  if [ -n "$pending_domain" ] || [ -n "$pending_preview" ]; then
    migration_backup="$ENV_FILE.migration.$$"
    cp -p "$ENV_FILE" "$migration_backup"
    configure "$pending_domain" "$pending_preview"
    note "Staged domain migration to ${pending_domain:-$(env_value KARMAX_DOMAIN)} (previews on $(env_value KARMAX_PREVIEW_DOMAIN)) for this deployment."
  fi

  note "Checking out validated revision $target…"
  git -C "$ROOT_DIR" checkout --detach "$target"
  # This file is the target's own, so it knows every secret the target mounts.
  if ! ensure_secrets; then
    git -C "$ROOT_DIR" checkout --detach "$previous"
    restore_migration
    cleanup_migration
    migration_backup=''
    die "deployment $target could not write its secrets; production remains at $previous"
  fi
  if ! preview_tls_ready; then
    git -C "$ROOT_DIR" checkout --detach "$previous"
    restore_migration
    cleanup_migration
    migration_backup=''
    die "deployment $target stopped: previews could not get certificates (see above); production remains at $previous"
  fi

  # Building does not replace the running container. It gives the one-off
  # snapshot process the candidate's backup implementation while production
  # continues serving the previous image.
  if ! build_images --pull; then
    git -C "$ROOT_DIR" checkout --detach "$previous"
    restore_migration
    cleanup_migration
    migration_backup=''
    die "deployment $target could not be built; production remains at $previous"
  fi
  # A running workflow replays its history under whatever code the next worker
  # loads, and one that cannot is wedged at its next event (WF-34 would have
  # wedged every task on tavya.io). The candidate replays them all first.
  if [ "${KARMAX_SKIP_REPLAY_CHECK:-}" = 1 ]; then
    echo 'karmax: warning: replay check skipped (KARMAX_SKIP_REPLAY_CHECK=1); running workflows may not survive this release' >&2
  else
    note 'Replaying the running workflows under the candidate…'
    if ! dc run --rm --no-deps -T app npm run --silent replay-check; then
      git -C "$ROOT_DIR" checkout --detach "$previous"
      restore_migration
      build_images || true
      cleanup_migration
      migration_backup=''
      die "deployment $target stopped by the replay check, which lists above the running workflows it cannot replay or why it could not run; production remains at $previous. Fix the release, or rerun with KARMAX_SKIP_REPLAY_CHECK=1 only if those workflows may break"
    fi
  fi
  if ! cmd_backup_candidate; then
    git -C "$ROOT_DIR" checkout --detach "$previous"
    restore_migration
    build_images || true
    cleanup_migration
    migration_backup=''
    die "deployment $target could not be backed up; production remains at $previous"
  fi
  # The candidate's first boot may migrate the vault one way (data epoch 3),
  # where no automatic rollback follows. Check it read-only with the new image
  # first. A secret it would quarantine (exit 3) keeps the previous app serving
  # unless the operator accepts the findings; a refused key, an unreadable file
  # or a vault it cannot open (exit 4) means the boot would fail, and always does.
  preflight=0
  dc run --rm --no-deps -T app npm run --silent vault-preflight || preflight=$?
  if [ "$preflight" -eq 3 ] && [ -n "$accept_vault" ]; then
    note 'Proceeding past the vault preflight findings (--accept-vault-findings).'
  elif [ "$preflight" -ne 0 ]; then
    git -C "$ROOT_DIR" checkout --detach "$previous"
    restore_migration
    build_images || true
    cleanup_migration
    migration_backup=''
    [ "$preflight" -eq 3 ] \
      && die "deployment $target stopped by the vault preflight; production remains at $previous. Fix what it reported, or rerun update with --accept-vault-findings"
    die "deployment $target could not boot on this vault (see the vault preflight above); production remains at $previous. Fix what it reported first"
  fi

  # An update must not break an edge that worked before it (a release can move
  # Caddy's ports or how it reaches the app). One that could not answer yet (no
  # certificate or DNS) does not gate the release.
  edge_before=0
  if edge_answers; then edge_before=1; fi
  app_ready=0
  if dc up -d --remove-orphans && wait_ready; then
    app_ready=1
    if [ "$edge_before" = 0 ] || wait_edge; then
      cleanup_migration
      migration_backup=''
      report_app_role || true
      reclaim_space
      note "Update complete at $target."
      return 0
    fi
  fi

  # Candidate startup can change durable data and advance Temporal histories.
  # Reverting only code across an incompatible boundary would hide or overwrite
  # data. Preserve the candidate/data and stop serving instead; recovery must
  # repair forward or explicitly restore a coordinated pre-update backup.
  if [ "$previous_epoch" != "$target_epoch" ]; then
    # A healthy app behind a broken edge keeps working its tasks; stopping it
    # would only add to the outage.
    [ "$app_ready" = 0 ] || die "deployment $target runs across data epochs $previous_epoch -> $target_epoch, but https://$(env_value KARMAX_DOMAIN) no longer answers through Caddy; code-only rollback refused, app left running. Repair the edge forward (./deploy/karmax logs caddy)"
    dc stop app || die "deployment $target failed across data epochs; could not stop the app; manual recovery required"
    die "deployment $target failed across data epochs $previous_epoch -> $target_epoch; app stopped, data retained, code-only rollback refused. Repair forward or restore the pre-update backup at $destination with its matching code and Temporal history"
  fi

  # The previous image may have been replaced under the Compose service tag, so
  # rebuild it from the previous exact source before bringing the service back.
  note "Deployment $target failed; rolling back to $previous…"
  git -C "$ROOT_DIR" checkout --detach "$previous"
  restore_migration
  if build_images && dc up -d --remove-orphans && wait_ready && { [ "$edge_before" = 0 ] || wait_edge; }; then
    cleanup_migration
    migration_backup=''
    die "deployment $target failed; production was restored to $previous"
  fi
  die "deployment $target failed and automatic rollback to $previous also failed"
}

# The superuser password: Temporal and the setup jobs connect with it, and
# releases before the karmax role gave it to the app as well. The new value
# travels on psql's stdin and in files, never on a command line `ps` shows.
cmd_rotate_postgres_password() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  password=$(random_hex 32)
  staged="$ENV_FILE.rotate.$$"
  if ! (umask 077 && { sed '/^POSTGRES_PASSWORD=/d' "$ENV_FILE" && printf 'POSTGRES_PASSWORD=%s\n' "$password"; } > "$staged"); then
    rm -f "$staged"; die 'could not stage the new password; nothing was changed'
  fi
  if ! printf "ALTER ROLE temporal PASSWORD '%s';\n" "$password" \
      | dc exec -T postgresql psql -U temporal -d postgres -v ON_ERROR_STOP=1 -q; then
    rm -f "$staged"; die 'PostgreSQL refused the new password; nothing was changed'
  fi
  mv "$staged" "$ENV_FILE"
  note 'Password changed. Restarting PostgreSQL and Temporal with it…'
  dc up -d --no-build --remove-orphans
  wait_ready || die 'Karmax failed its readiness check after the password change'
  report_app_role
  note 'PostgreSQL password rotated.'
}

# The vault's key encryption key (SS-1, wiki features/vault-encryption). The
# vault holds every data key wrapped under it, possibly under several keys, so
# each step can be repeated after an interruption, and the previous key keeps
# opening everything until the last one:
#   1. wrap every data key under a new key (vault_key.next), the app serving;
#   2. stop the app, wrap what it created meanwhile, switch the files
#      (vault_key -> vault_key.previous, vault_key.next -> vault_key), start it;
#   3. prune the previous key's wraps, and retire it.
# Run it again to finish an interrupted rotation.
cmd_rotate_vault_key() {
  need_docker
  [ -f "$ENV_FILE" ] || die 'this instance is not configured'
  current="$SECRETS_DIR/vault_key" next="$SECRETS_DIR/vault_key.next" previous="$SECRETS_DIR/vault_key.previous"
  [ -s "$current" ] || die 'missing secret: vault_key'
  wrap_under_next() {
    dc "$@" -v "$next:/run/secrets/vault_key_next:ro" app npm run --silent vault-key -- add /run/secrets/vault_key_next
  }
  # Interrupted between saving the previous key and moving the new one in.
  if [ -s "$next" ] && [ -s "$previous" ]; then
    cmp -s "$previous" "$current" || die "both $next and $previous exist and $current is neither: inspect them before rotating again"
    mv "$next" "$current" || die 'could not move the new vault key into place'
  fi
  if [ ! -s "$previous" ]; then
    if [ ! -s "$next" ]; then
      ( umask 077 && random_hex 48 > "$next.tmp" && mv "$next.tmp" "$next" ) || die 'could not write the new vault key; nothing was changed'
    fi
    secret_mode "$next" || die "could not set the mode of $next"
    note 'Wrapping every data key under the new vault key while the app serves…'
    wrap_under_next run --rm --no-deps -T || die 'could not wrap the data keys under the new key; the vault still uses the current key, and running this again resumes'
    note 'Stopping the app to switch keys…'
    dc stop app || die 'could not stop the app; the vault still uses the current key'
    if ! wrap_under_next run --rm --no-deps -T; then
      dc up -d --no-build app || true
      die 'could not wrap the data keys created meanwhile; the app was restarted on the current key, and running this again resumes'
    fi
    ( umask 077 && cp -p "$current" "$previous.tmp" && mv "$previous.tmp" "$previous" ) || die 'could not save the previous vault key; the app is stopped on the current key: start it with ./deploy/karmax up'
    mv "$next" "$current" || die "could not move the new vault key into place; run this again (the app is stopped)"
  fi
  note 'Starting the app with the new vault key…'
  if ! { dc up -d --no-build app && wait_ready; }; then
    die "the app did not become ready on the new vault key. The previous key still opens the vault: mv $previous $current and start it (./deploy/karmax up), or fix the start and run this again"
  fi
  note 'Removing the previous key from the vault…'
  dc exec -T app npm run --silent vault-key -- prune || die 'could not prune the previous key; the vault opens with the new key, and running this again finishes'
  retired="$SECRETS_DIR/vault_key.retired-$(date -u +%Y%m%dT%H%M%SZ)"
  mv "$previous" "$retired" || die "could not retire $previous"
  note 'Vault key rotated.'
  note "Backups taken before now still need the previous key: copy $retired off-host, keep it as long as those backups, then delete it here."
  note "Keep a copy of the new $current off-host too: backups never carry it."
}

usage() {
  cat <<'EOF'
Usage: ./deploy/karmax COMMAND

  up DOMAIN [PREVIEW-DOMAIN]  Configure or start the complete HTTPS stack
  doctor                       Validate configuration, containers, DNS, and HTTPS
  status                       Show service health
  logs [SERVICE]               Follow logs (app by default)
  backup [DIRECTORY]           Snapshot Karmax, object data and Temporal (never the vault key)
  prune-backups                Drop automatic snapshots past their retention
  restore [--trust-key FP] [--accept-unsigned-v1] [--vault-key FILE] DIRECTORY
                               Verify signatures and the vault key, restore a complete snapshot
  update [--accept-vault-findings] [REVISION]
                               Backup, check the vault, deploy an exact master revision, and restart
  rotate-postgres-password      Replace PostgreSQL's superuser password
  rotate-vault-key              Replace the vault's key encryption key (resumable)
  migrate-objects [--verify-only] [--concurrency N]
                               Copy local objects to the configured S3 store
  reconcile-storage [--orphans N]
                               Compare the object store with the database (read-only)
  deploy-repository-edge       Deploy the Cloudflare Worker sandboxes save resources through
                               (needs CLOUDFLARE_API_TOKEN), and use it
  deploy-agent-mail-edge MAIL-DOMAIN
                               Deploy the Cloudflare Email Worker agent mail arrives through
  configure-backups s3://BUCKET/PREFIX https://ENDPOINT PUBLIC_KEY
                               Stream PostgreSQL WAL and base backups off-host (key in
                               KARMAX_PG_BACKUP_ACCESS_KEY_ID / _SECRET_ACCESS_KEY)
  pg-restore --private-key FILE [--to TIME] [--keep]
                               Point-in-time restore of those backups into a scratch volume
  down                          Stop everything without deleting durable data
EOF
}

command=${1:-help}
[ "$#" -eq 0 ] || shift
case "$command" in
  up) cmd_up "$@" ;;
  doctor) cmd_doctor "$@" ;;
  status) need_docker; [ -f "$ENV_FILE" ] || die 'not configured'; dc ps ;;
  logs) need_docker; [ -f "$ENV_FILE" ] || die 'not configured'; dc logs -f --tail=200 "${1:-app}" ;;
  backup) cmd_backup "$@" ;;
  prune-backups) prune_backups ;;
  restore) cmd_restore "$@" ;;
  update) cmd_update "$@" ;;
  rotate-postgres-password) cmd_rotate_postgres_password "$@" ;;
  rotate-vault-key) cmd_rotate_vault_key "$@" ;;
  migrate-objects) cmd_migrate_objects "$@" ;;
  reconcile-storage) cmd_reconcile_storage "$@" ;;
  deploy-repository-edge) cmd_deploy_repository_edge "$@" ;;
  deploy-agent-mail-edge) cmd_deploy_agent_mail_edge "$@" ;;
  configure-backups) cmd_configure_backups "$@" ;;
  pg-restore) cmd_pg_restore "$@" ;;
  down) need_docker; [ -f "$ENV_FILE" ] || die 'not configured'; dc down ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
