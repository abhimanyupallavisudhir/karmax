KARMAX_DOMAIN=karmax.example.com
KARMAX_PREVIEW_DOMAIN=preview.karmax.example.com
# One wildcard certificate for previews, by DNS-01 on Cloudflare (default
# on-demand: one per preview). Needs .secrets/cloudflare_dns_api_token (Zone DNS
# Edit + Zone Read on the preview zone only); Compose mounts that file either
# way, so create it empty when unused.
# KARMAX_PREVIEW_TLS=cloudflare
# The preview domain before a move; its leases keep their hostnames until they expire.
# KARMAX_LEGACY_PREVIEW_DOMAIN=preview.old-karmax.example.com
# Agent email addresses (agent-<token>@…) through Cloudflare Email Routing and
# the Email Worker `deploy/karmax deploy-agent-mail-edge` deploys.
# KARMAX_AGENT_MAIL_DOMAIN=mail.karmax-usercontent.example
# Optional old origin retained as an HTTPS redirect after a domain migration.
# KARMAX_LEGACY_DOMAIN=old-karmax.example.com
# KARMAX_LEGACY_WWW_DOMAIN=www.old-karmax.example.com
KARMAX_CELL_ID=eu-1

# Put the managed PostgreSQL connection string in deploy/.secrets/database_url,
# not in this environment file. The app imports legacy SQLite state on its first
# successful connection and then records a durable migration marker.

# A managed Temporal namespace. Add TLS file variables when using mTLS instead
# of the API-key secret mounted by compose.
KARMAX_TEMPORAL_ADDRESS=eu-west-1.aws.api.temporal.io:7233
KARMAX_TEMPORAL_NAMESPACE=karmax.example

# Any S3-compatible object store. Use a cell-specific bucket or prefix policy.
KARMAX_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
KARMAX_S3_BUCKET=karmax-eu-1
KARMAX_S3_REGION=eu-west-1

# GitHub and world-provider connections are configured in Organization settings
# and stored encrypted in Karmax. They are intentionally absent from this file.
KARMAX_CLOUD_WORLD_PROVIDER=e2b

# Hosted SaaS subscription Stripe credentials, catalog IDs, legal details, and
# the founder checklist are configured after sign-in at Installation settings →
# Paid launch. Secrets are stored in the encrypted krmax vault.

# Optional worst-case micro-dollar debit per managed model request. This does
# not contain credentials and does not enable an organization by itself; an
# owner must still set a spend cap and provider allowlist. Leave empty for BYOK-only.
# KARMAX_MANAGED_MODEL_REQUEST_CEILINGS={"openai/gpt-5.5":1000000,"anthropic/*":1500000}
# Optional micro-dollar rates per one million provider-reported tokens. Omit a
# model to retain its ceiling as a clearly labelled estimate after completion.
# KARMAX_MANAGED_MODEL_PRICING={"openai/gpt-5.5":{"inputMicrosPerMillionTokens":1250000,"outputMicrosPerMillionTokens":10000000,"cacheReadMicrosPerMillionTokens":125000}}

# Optional first-boot fallback for real agent payments. Installation admins
# normally configure the Connect app in Organization settings → Payments, where
# Karmax stores secrets in its encrypted vault. These are never tenant funds.
STRIPE_CLIENT_ID=ca_...
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: keep the model picker's "Compare models" chart (Artificial
# Analysis intelligence, cost and time) current by fetching it once a day.
# Without it the chart uses the snapshot bundled with the release.
# ARTIFICIAL_ANALYSIS_API_KEY=aa_...

# Paid checkout is deliberately off until it is explicitly enabled from the
# guided Paid launch page.
