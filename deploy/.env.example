KARMAX_DOMAIN=karmax.example.com
KARMAX_PREVIEW_DOMAIN=preview.karmax.example.com
KARMAX_CELL_ID=eu-1

# A managed Temporal namespace. Add TLS file variables when using mTLS instead
# of the API-key secret mounted by compose.
KARMAX_TEMPORAL_ADDRESS=eu-west-1.aws.api.temporal.io:7233
KARMAX_TEMPORAL_NAMESPACE=karmax.example

# Any S3-compatible object store. Use a cell-specific bucket or prefix policy.
KARMAX_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
KARMAX_S3_BUCKET=karmax-eu-1
KARMAX_S3_REGION=eu-west-1

# GitHub and world-provider connections are configured in Organization settings
# and stored encrypted in Karmax. They are intentionally absent from this file.
KARMAX_CLOUD_WORLD_PROVIDER=e2b
