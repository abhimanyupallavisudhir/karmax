{
	# Caddy runs on the host network, where its admin API would let any local
	# process rewrite the edge. Restart the container to apply a change.
	admin off
	on_demand_tls {
		ask http://127.0.0.1:4505/api/tls/preview-allow
	}
}

(karmax_security) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Registration is open to the internet, so the edge — not the app — is what
# bounds a stranger's cost. Keyed on the client address; Caddy terminates TLS
# here, so that is the real peer and not a header anyone can set.
(karmax_ratelimit) {
	rate_limit {
		# Account creation. karmax's /api/signup and /api/setup call Better
		# Auth's *server* API directly, which bypasses Better Auth's own
		# limiter (that runs only in its HTTP router), so nothing else covers
		# these. Tight enough to stop scripted signup spam filling the disk,
		# loose enough for a few friends behind one NAT.
		zone signup {
			match {
				path /api/signup /api/setup
			}
			key {http.request.remote.host}
			events 10
			window 1h
		}
		# Credential guessing. /api/login is karmax's own password route and is
		# likewise not covered by Better Auth; /api/auth/* is, but a second
		# bound means a regression there is not immediately fatal.
		# /api/invitations/accept is unauthenticated and grants organization
		# membership on presenting a token, so it belongs here and not in the
		# general budget.
		zone auth {
			match {
				path /api/login /api/auth/* /api/invitations/accept
			}
			key {http.request.remote.host}
			events 30
			window 1m
		}
		# Everything else, including anything added later: generous enough for
		# the console's burst on load, low enough that nobody mines the API for
		# free. A zone with no matcher applies to every request.
		zone api {
			key {http.request.remote.host}
			events 600
			window 1m
		}
	}
}

{$KARMAX_DOMAIN} {
	import karmax_security
	# Project resources are restic repositories that task sandboxes save to and
	# restore from, through a Cloudflare Worker: every customer's sandboxes
	# arrive from the same few Cloudflare addresses, so no budget here can be
	# per address. Every request must carry a signed grant for one repository,
	# and the app gives each grant its own budget once it has checked the
	# signature (GrantLimits in src/world/resource-repository.ts), which no
	# header can imitate.
	handle /resource-repositories/* {
		reverse_proxy 127.0.0.1:4505 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}
	handle {
		import karmax_ratelimit
		# The app sends each document its own policy (console, public pages, agent
		# content). Anything it answers without one gets this locked-down default,
		# so a page added later is not left unprotected. Previews are exempt: they
		# serve people's own apps on their own origins.
		header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		reverse_proxy 127.0.0.1:4505 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}
}

# People type the www host out of habit, and without this they get a
# certificate error — worse than the registrar's parking page it replaces.
# Redirecting rather than serving keeps one canonical origin, so sessions,
# CORS, and the preview-origin separation stay unambiguous.
www.{$KARMAX_DOMAIN} {
	import karmax_security
	import karmax_ratelimit
	redir https://{$KARMAX_DOMAIN}{uri} permanent
}

# A domain migration keeps old bookmarks and emailed links working while making
# the new origin canonical. Users sign in again on the new cookie origin.
# GitHub does not follow webhook redirects, so preserve that signed endpoint
# until its provider configuration has also moved. The loopback defaults leave
# this inert on installations that have never moved.
{$KARMAX_LEGACY_DOMAIN:http://127.0.0.1:65535} {
	import karmax_security
	import karmax_ratelimit
	handle /api/github/webhook {
		reverse_proxy 127.0.0.1:4505 {
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}
	handle {
		redir https://{$KARMAX_DOMAIN}{uri} permanent
	}
}

{$KARMAX_LEGACY_WWW_DOMAIN:http://127.0.0.1:65534} {
	import karmax_security
	redir https://{$KARMAX_DOMAIN}{uri} permanent
}

# Live previews. Each lease gets its own opaque origin, p-<hash>.<preview
# domain>, on a separately registered domain, so a tenant's app shares no
# cookies, storage or reputation with the console. The app sets no cookie
# scoped to the domain, and says no-referrer so a lease's URL never leaks.
(karmax_preview) {
	import karmax_security
	header Referrer-Policy no-referrer
	reverse_proxy 127.0.0.1:4505 {
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

# How preview hosts get certificates (KARMAX_PREVIEW_TLS):
# - on-demand: one per host at its first handshake, once Caddy has asked the
#   app whether it issued the name (to a lease live or recently ended), so the
#   name cannot be used to mint certificates for arbitrary hosts. Let's Encrypt
#   issues 50 a week per registered domain.
# - cloudflare: one wildcard certificate for the whole domain, proved by a DNS
#   record (DNS-01) that Caddy writes with the Cloudflare API token in
#   .secrets/cloudflare_dns_api_token (Zone DNS Edit + Zone Read on that zone
#   only). No per-preview certificate, so no weekly limit.
(preview_certificate_on-demand) {
	tls {
		on_demand
	}
}
(preview_certificate_cloudflare) {
	tls {
		dns cloudflare {file./run/secrets/cloudflare_dns_api_token}
	}
}

# A stopped preview still answers over HTTPS with a page saying so, instead
# of failing the TLS handshake. The bare domain serves nothing.
*.{$KARMAX_PREVIEW_DOMAIN} {
	import preview_certificate_{$KARMAX_PREVIEW_TLS:on-demand}
	import karmax_preview
}

# Leases issued under an earlier preview domain keep their hostnames until
# they expire, on demand as before. Any other name is refused.
https:// {
	tls {
		on_demand
	}
	@legacy_preview host *.{$KARMAX_LEGACY_PREVIEW_DOMAIN:invalid}
	handle @legacy_preview {
		import karmax_preview
	}
	handle {
		abort
	}
}
