<?xml version="1.0" encoding="utf-8"?>
<!-- The For-me widget (ForMeWidget): the count opens For me, the mic opens Ask listening. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:id="@+id/widget_for_me"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="–"
            android:textColor="@color/tavya_widget_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_for_me"
            android:textColor="@color/tavya_widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_mic_background"
        android:contentDescription="@string/widget_ask_by_voice"
        android:padding="12dp"
        android:src="@drawable/widget_mic" />
</LinearLayout>
