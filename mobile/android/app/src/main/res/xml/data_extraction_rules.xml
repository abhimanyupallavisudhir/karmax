<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app leaves the phone in a backup or a move to a new phone (Android 12+):
     its WebView holds a signed-in session, and the rest is a copy of what tavya keeps.
     Android 11 and earlier: android:allowBackup="false" in the manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
