<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- TavyaSignIn: the browser returns here after system-browser sign-in. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.tavya.app" android:host="signed-in" />
            </intent-filter>

            <!-- The phone's own links into the console (EntryPoints, the widget, the tile):
                 io.tavya.app://open?path=…, ask, new, for-me, share. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.tavya.app" />
            </intent-filter>

            <!-- Share to tavya: text, links and any files (ShareInbox). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- tavya as the digital-assistant app (Settings → Default apps): the long-press opens Ask listening.
                 Choosing it replaces Google's assistant and "Hey Google" for that person. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Verified links (App Links) to the console. The paths that are not the console's
             (AppLinks.EXCLUDED_PATHS = APP_LINK_EXCLUDED_PATHS in src/platform/app-links.ts)
             stay in the browser: excluded here on Android 15+, sent back by LinkActivity before. -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${tavyaLinkScheme}" android:host="${tavyaLinkHost}" />
                <uri-relative-filter-group android:allow="false">
                    <data android:path="/" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/docs" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/pricing" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/legal" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/compare" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/about" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/changelog" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/api/" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/oauth/" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/.well-known/" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/device" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/share/" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/git/" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/download/" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/mcp" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/ws" />
                </uri-relative-filter-group>
                <uri-relative-filter-group android:allow="false">
                    <data android:pathPrefix="/link/" />
                </uri-relative-filter-group>
            </intent-filter>
        </activity>

        <!-- Quick Settings tile "Ask tavya". -->
        <service
            android:name=".AskTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_ask"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
        </service>

        <!-- Home-screen widget: For-me count and a mic. -->
        <receiver
            android:name=".ForMeWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_for_me_info" />
        </receiver>

        <!-- FCM: Capacitor's service plus the widget's background refresh (TavyaMessagingService) replaces the plugin's own. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".TavyaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Push (FCM): small icon and accent colour for notifications FCM displays itself. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_tavya" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/tavya_notification" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push: asked at runtime by PushNotifications.requestPermissions() on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice: also merged from @capacitor-community/speech-recognition; stated here so it can't silently disappear. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Voice is optional: don't hide the app from devices without a microphone. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <!-- Android 11+ package visibility: find the system speech recogniser. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Android 11+ package visibility: a browser for the links that are not the console's (LinkActivity). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Android 11+ package visibility: find browsers that support Custom Tabs (TavyaSignIn). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
